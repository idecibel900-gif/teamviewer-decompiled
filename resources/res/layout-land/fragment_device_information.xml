<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:background="@color/tv_device_information_top_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/lineDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/avatar_image_container"
            android:layout_width="@dimen/tv_device_avatar_size"
            android:layout_height="@dimen/tv_device_avatar_size"
            android:layout_marginTop="@dimen/tv_device_information_avatar_margin_land"
            app:layout_constraintBottom_toTopOf="@+id/device_information_device_name"
            app:layout_constraintEnd_toStartOf="@+id/lineDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/tv_device_information_title_text_size"
            android:textColor="@color/tv_black_high_emphasis"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/device_information_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_device_information_title_margin_top"
            android:layout_marginBottom="@dimen/tv_device_information_avatar_margin_land"
            android:maxLines="1"
            android:layout_marginStart="@dimen/tv_device_information_title_margin_start_end"
            android:layout_marginEnd="@dimen/tv_device_information_title_margin_start_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/lineDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar_image_container"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/lineDivider"
            android:background="@color/monitoring_alert_divider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/lineDivider"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/tv_device_information_subtitle_text_size"
                    android:textColor="@color/tv_device_information_subtitle_text_color"
                    android:id="@+id/device_alarm_details_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_device_information_subtitle_margin_top"
                    android:text="@string/tv_device_information_subtitle"
                    android:layout_marginStart="@dimen/tv_device_information_title_margin_start_end"
                    android:layout_marginEnd="@dimen/tv_device_information_title_margin_start_end"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/tv_device_information_element_title_text_size"
                    android:textColor="@color/tv_black_high_emphasis"
                    android:ellipsize="end"
                    android:id="@+id/device_information_os_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_device_information_element_title_margin_top"
                    android:text="@string/tv_device_information_os"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_alarm_details_subtitle"/>
                <TextView
                    android:textSize="@dimen/tv_device_information_element_text_size"
                    android:textColor="@color/tv_gray_low_emphasis"
                    android:id="@+id/device_information_os"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_information_os_title"/>
                <TextView
                    android:textSize="@dimen/tv_device_information_element_title_text_size"
                    android:textColor="@color/tv_black_high_emphasis"
                    android:ellipsize="end"
                    android:id="@+id/device_information_hardware_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_device_information_element_title_margin_top"
                    android:text="@string/tv_device_information_hardware"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_information_os"/>
                <TextView
                    android:textSize="@dimen/tv_device_information_element_text_size"
                    android:textColor="@color/tv_gray_low_emphasis"
                    android:id="@+id/device_information_hardware"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_information_hardware_title"/>
                <TextView
                    android:textSize="@dimen/tv_device_information_element_title_text_size"
                    android:textColor="@color/tv_black_high_emphasis"
                    android:ellipsize="end"
                    android:id="@+id/device_information_domain_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_device_information_element_title_margin_top"
                    android:text="@string/tv_device_information_domain"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_information_hardware"/>
                <TextView
                    android:textSize="@dimen/tv_device_information_element_text_size"
                    android:textColor="@color/tv_gray_low_emphasis"
                    android:id="@+id/device_information_domain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_information_domain_title"/>
                <TextView
                    android:textSize="@dimen/tv_device_information_element_title_text_size"
                    android:textColor="@color/tv_black_high_emphasis"
                    android:ellipsize="end"
                    android:id="@+id/device_information_internal_ip_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_device_information_element_title_margin_top"
                    android:text="@string/tv_device_information_internal_ip"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_information_domain"/>
                <TextView
                    android:textSize="@dimen/tv_device_information_element_text_size"
                    android:textColor="@color/tv_gray_low_emphasis"
                    android:id="@+id/device_information_internal_ip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_information_internal_ip_title"/>
                <TextView
                    android:textSize="@dimen/tv_device_information_element_title_text_size"
                    android:textColor="@color/tv_black_high_emphasis"
                    android:ellipsize="end"
                    android:id="@+id/device_information_external_ip_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_device_information_element_title_margin_top"
                    android:text="@string/tv_device_information_external_ip"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_information_internal_ip"/>
                <TextView
                    android:textSize="@dimen/tv_device_information_element_text_size"
                    android:textColor="@color/tv_gray_low_emphasis"
                    android:id="@+id/device_information_external_ip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_information_external_ip_title"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="@dimen/tv_device_information_subtitle_margin_top"
                    app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                    app:layout_constraintTop_toBottomOf="@+id/device_information_external_ip"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
