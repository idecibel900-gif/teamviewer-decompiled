<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/buddy_expandable_item_actions_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:background="@drawable/buddy_expandable_item_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/tableRow"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/partner_list_partner_min_height">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/partner_list_partner_icon_padding_start">
                <com.teamviewer.remotecontrollib.gui.view.picture.AccountPictureView
                    android:layout_gravity="center"
                    android:id="@+id/buddy_account_picture_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/user_placeholder_image"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/buddy_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/buddy_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/partner_list_partner_text_padding_start">
                <TextView
                    android:textSize="@dimen/buddy_list_item_text_size"
                    android:ellipsize="end"
                    android:id="@+id/buddy_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:textIsSelectable="false"
                    android:textAlignment="viewStart"/>
                <FrameLayout
                    android:id="@+id/buddy_connect_button_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ImageButton
                        android:id="@+id/connect_button_partner"
                        app:srcCompat="@drawable/connect_icon"
                        style="@style/TVImageButtonPartnerSecondaryAction"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/buddy_wake_up_button_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ImageButton
                        android:src="0x7f080275"
                        app:tint="@color/accent"
                        style="@style/TVImageButtonPartnerSecondaryAction"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/buddy_start_app_button_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ProgressBar
                        android:gravity="center_vertical"
                        android:id="@+id/marker_progress"
                        android:layout_width="@dimen/buddy_list_item_secondary_action_loading_size"
                        android:layout_height="@dimen/buddy_list_item_secondary_action_loading_size"
                        android:layout_margin="@dimen/partner_list_partner_secondary_action_margin"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
