<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textStyle="bold"
        android:id="@+id/tv_mfa_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_device_authentication_notification_content_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tv_mfa_location_identifier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_mfa_title"
        android:layout_marginEnd="5sp">
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:id="@+id/tv_mfa_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_device_authentication_notification_content_text_receiver"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:id="@+id/tv_mfa_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_device_authentication_notification_content_text_sender"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textStyle="bold"
        android:ellipsize="middle"
        android:id="@+id/tv_mfa_to_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_toRightOf="@+id/tv_mfa_location_identifier"
        android:layout_below="@+id/tv_mfa_title"
        android:textIsSelectable="true"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textStyle="bold"
        android:ellipsize="middle"
        android:id="@+id/tv_mfa_from_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_toRightOf="@+id/tv_mfa_location_identifier"
        android:layout_below="@+id/tv_mfa_to_data"
        android:textIsSelectable="true"/>
</RelativeLayout>
