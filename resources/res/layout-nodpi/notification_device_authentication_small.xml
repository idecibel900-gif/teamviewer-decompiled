<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textStyle="bold"
        android:id="@+id/tv_mfa_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_device_authentication_notification_content_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:id="@+id/tv_mfa_to"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_device_authentication_notification_content_text_receiver"
        android:layout_below="@+id/tv_mfa_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textStyle="bold"
        android:ellipsize="end"
        android:id="@+id/tv_mfa_to_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_toRightOf="@+id/tv_mfa_to"
        android:layout_below="@+id/tv_mfa_title"
        android:layout_marginStart="5sp"/>
</RelativeLayout>
