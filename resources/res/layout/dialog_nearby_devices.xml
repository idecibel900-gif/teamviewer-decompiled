<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_nearby_devices_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/nearby_devices_dialog_portrait_min_height">
    <TextView
        android:textSize="@dimen/nearby_devices_dialog_title_text_size"
        android:textColor="@color/tv_black_high_emphasis"
        android:id="@+id/nearby_devices_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nearby_devices_dialog_title_text_margin_top"
        android:text="@string/tv_dialog_nearby_devices_title"
        android:drawableLeft="@drawable/ic_device_discovery"
        android:drawablePadding="@dimen/nearby_devices_dialog_title_text_drawable_padding"
        android:layout_marginStart="@dimen/nearby_devices_dialog_title_text_margin_start"
        android:layout_marginEnd="@dimen/nearby_devices_dialog_title_text_margin_end"
        android:drawableTint="@color/tv_black_high_emphasis"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/connect_dialog_nearby_devices_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/nearby_devices_dialog_divider_height"
        android:layout_marginTop="@dimen/nearby_devices_dialog_divider_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nearby_devices_text"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/no_devices_found_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <ExpandableListView
            android:id="@+id/nearby_devices_dropdown_list"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:groupIndicator="@null"
            android:childDivider="@color/connect_dialog_nearby_devices_child_divider_color"
            android:divider="@android:color/background_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ProgressBar
            android:id="@+id/device_discovery_progressBar"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/no_devices_found_image"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_no_devices_found"
            app:layout_constraintBottom_toTopOf="@+id/no_devices_found_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/connect_no_devices_found_text"
            android:gravity="center"
            android:id="@+id/no_devices_found_text"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/tv_no_devices_found"
            android:layout_marginStart="@dimen/nearby_devices_dialog_no_devices_found_margin_start"
            android:layout_marginEnd="@dimen/nearby_devices_dialog_no_devices_found_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/no_devices_found_image"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
