<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorBuddylistBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/colorBuddylistBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/group_loading_progress_bar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:indeterminate="true"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/plQuickAccessLayout"
                android:background="@color/colorBuddylistSectionBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/material_text_size_caption"
                    android:textColor="@color/colorBuddylistSectionTitle"
                    android:gravity="center_vertical"
                    android:id="@+id/list_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/redesign_material_section_caption_height"
                    android:text="@string/tv_quick_access"
                    android:layout_centerVertical="false"
                    android:textIsSelectable="false"
                    android:layout_marginStart="@dimen/redesign_material_section_caption_margin_left"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/plServiceQueueLayout"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/redesign_material_single_line_list_item_height"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/list_header_title">
                    <ImageView
                        android:id="@+id/plServiceQueueIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_service_queue"
                        android:layout_marginStart="@dimen/redesign_material_single_line_list_item_padding_left"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/material_two_line_list_item_primary_text_size"
                        android:textColor="@color/colorBuddylistSectionItemTextPrimary"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:id="@+id/plServiceQueueText"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tv_serviceCases"
                        android:maxLines="1"
                        android:textIsSelectable="false"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="@dimen/redesign_material_list_item_text_padding_left_relative"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/plServiceQueueIcon"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/plMonitoringOverviewLayout"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/redesign_material_single_line_list_item_height"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/plServiceQueueLayout">
                    <ImageView
                        android:id="@+id/plMonitoringOverviewIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_monitoring_overview"
                        android:layout_marginStart="@dimen/redesign_material_single_line_list_item_padding_left"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/redesign_material_list_item_text_padding_left_relative"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/plMonitoringOverviewIcon"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="@dimen/material_two_line_list_item_primary_text_size"
                            android:textColor="@color/colorBuddylistSectionItemTextPrimary"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:id="@+id/plMonitoringOverviewText"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tv_monitoring_overview"
                            android:maxLines="1"
                            android:textIsSelectable="false"
                            android:textAlignment="viewStart"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/material_two_line_list_item_secondary_text_size"
                            android:textColor="@color/colorBuddylistSectionItemTextSecondary"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:id="@+id/plMonitoringOverviewSubtext"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tv_monitoring_overview_subtext"
                            android:maxLines="1"
                            android:textIsSelectable="false"
                            android:textAlignment="viewStart"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/plMonitoringOverviewText"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/plManagerGroupsLayout"
                android:background="@color/colorBuddylistSectionBackground"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/view4"
                    android:background="@color/colorBuddylistSectionSeparator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/material_text_size_caption"
                    android:textColor="@color/colorBuddylistSectionTitle"
                    android:gravity="center_vertical"
                    android:id="@+id/list_header_manged_groups"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/redesign_material_section_caption_height"
                    android:layout_marginTop="1dp"
                    android:text="@string/tv_managed_groups"
                    android:layout_centerVertical="true"
                    android:textIsSelectable="false"
                    android:layout_marginStart="@dimen/redesign_material_section_caption_margin_left"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <include
                    android:id="@+id/included_managed_groups"
                    layout="@layout/fragment_managed_group_layout"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/plGroupsLayout"
                android:background="@color/colorBuddylistSectionBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/view3"
                    android:background="@color/colorBuddylistSectionSeparator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/material_text_size_caption"
                    android:textColor="@color/colorBuddylistSectionTitle"
                    android:gravity="center_vertical"
                    android:id="@+id/list_header_groups"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/redesign_material_section_caption_height"
                    android:layout_marginTop="1dp"
                    android:text="@string/tv_groups"
                    android:layout_centerVertical="true"
                    android:textIsSelectable="false"
                    android:layout_marginStart="@dimen/redesign_material_section_caption_margin_left"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/plGroupRecyclerView"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/list_header_groups"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <View
            android:id="@+id/fabDarkBackground"
            android:background="#80000014"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
