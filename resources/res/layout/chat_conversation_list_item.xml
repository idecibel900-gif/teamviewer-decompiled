<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/chat_list_conversation_min_height"
    android:paddingStart="@dimen/chat_list_conversation_padding_left"
    android:paddingEnd="@dimen/chat_list_conversation_padding_right">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/account_picture_frame"
        android:layout_width="@dimen/chat_list_conversation_avatar_size"
        android:layout_height="@dimen/chat_list_conversation_avatar_size"
        android:layout_alignParentStart="true">
        <com.teamviewer.chatviewlib.view.AccountPictureView
            android:id="@+id/chat_conversation_account_picture_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_chat_placeholder"
            app:dimOfflineContacts="false"/>
        <ImageView
            android:id="@+id/chat_conversation_icon_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <TextView
        android:ellipsize="end"
        android:id="@+id/chat_conversation_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textIsSelectable="false"
        android:textAlignment="viewStart"
        android:paddingStart="@dimen/material_list_secondary_action_padding"
        android:layout_toStartOf="@+id/chat_conversation_timestamp"
        android:layout_toEndOf="@+id/account_picture_frame"
        style="@style/tv_chat_conversation_title"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/chat_conversation_last_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/chat_conversation_title"
        android:textIsSelectable="false"
        android:textAlignment="viewStart"
        android:paddingStart="@dimen/material_list_secondary_action_padding"
        android:layout_toEndOf="@+id/account_picture_frame"
        android:layout_alignParentEnd="true"
        style="@style/tv_chat_conversation_last_message"/>
    <TextView
        android:id="@+id/chat_conversation_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/chat_conversation_title"
        android:textIsSelectable="false"
        android:layout_marginStart="8dp"
        android:layout_alignParentEnd="true"
        style="@style/tv_chat_conversation_timestamp"/>
</RelativeLayout>
