<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/list_margin_left"
    android:paddingEnd="@dimen/list_margin_right">
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textStyle="bold"
        android:textColor="@color/tv_chat_newmessage_separator_text"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_chat_newmessage_separator"
        android:paddingEnd="5dp"/>
    <View
        android:layout_gravity="center"
        android:background="@drawable/drawable_chat_conversation_newmessage_separator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
