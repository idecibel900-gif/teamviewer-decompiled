<?xml version="1.0" encoding="utf-8"?>
<androidx.percentlayout.widget.PercentRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/chat_entry_padding"
    android:paddingTop="@dimen/chat_entry_padding"
    android:paddingRight="@dimen/list_margin_right"
    android:paddingBottom="@dimen/chat_entry_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/chat_entry_margin_right"
    android:paddingStart="@dimen/list_margin_left"
    android:paddingEnd="@dimen/chat_entry_padding"
    android:layout_marginEnd="@dimen/chat_entry_margin">
    <ImageView
        android:id="@+id/chat_outgoing_error_indicator"
        android:padding="@dimen/chat_entry_padding"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/chat_message_error_indicator"
        android:layout_alignBottom="@+id/chat_message_container"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/chat_message_container"
        android:background="@drawable/listitem_chat_message_outgoing_background"
        android:padding="@dimen/chat_entry_padding"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/chat_outgoing_error_indicator"
        android:layout_alignWithParentIfMissing="true"
        android:layout_toStartOf="@+id/chat_outgoing_error_indicator"
        android:backgroundTint="@color/tv_blue03"
        app:layout_widthPercent="60%">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/chat_message_thumbnail"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_marginTop="@dimen/chat_message_thumbnail_margin"
            android:layout_marginBottom="@dimen/chat_message_thumbnail_margin"
            android:scaleType="centerInside"
            android:contentDescription=""
            app:srcCompat="@drawable/file_thumbnail_placeholder_white"/>
        <TextView
            android:textSize="@dimen/chat_file_message_textview"
            android:textColor="@color/tv_chat_ownmessage_text"
            android:id="@+id/chat_message_outgoing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="false"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/chat_timestamp_text_size"
        android:textColor="@color/tv_chat_ownmessage_timestamp"
        android:id="@+id/chat_outgoing_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_alignBottom="@+id/chat_outgoing_error_indicator"
        android:layout_marginEnd="@dimen/chat_timestamp_margin"
        android:layout_toStartOf="@+id/chat_message_container"/>
</androidx.percentlayout.widget.PercentRelativeLayout>
