<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/unlocked_video_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/zoom_unlocked_image"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="0x7f0801b3"/>
        <VideoView
            android:id="@+id/unlocked_video"
            android:layout_width="@dimen/m2m_instructions_video_width"
            android:layout_height="@dimen/m2m_instructions_video_height"
            android:layout_alignParentTop="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/zoom_unlocked_image"/>
    </RelativeLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:layout_width="@dimen/m2m_instructions_video_description_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/tv_m2m_intro_unlocked"
        android:layout_below="@+id/unlocked_video_layout"
        android:paddingStart="20dp"
        android:layout_alignParentStart="true"/>
</merge>
