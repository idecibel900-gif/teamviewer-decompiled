<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/list_margin_left"
    android:paddingEnd="@dimen/list_margin_right">
    <FrameLayout
        android:id="@+id/chat_conversation_chatendpoint_frame_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_alignParentStart="true">
        <com.teamviewer.chatviewlib.view.AccountPictureView
            android:id="@+id/chat_conversation_chatendpoint_account_picture_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_chat_placeholder"/>
        <ImageView
            android:id="@+id/chat_conversation_chatendpoint_icon_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <TextView
        android:id="@+id/chat_conversation_chatendpoint_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/chat_conversation_chatendpoint_frame_layout"/>
</RelativeLayout>
