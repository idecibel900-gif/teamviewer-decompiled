<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/avatar_image_container"
            android:layout_width="@dimen/tv_device_avatar_size"
            android:layout_height="@dimen/tv_device_avatar_size"
            android:layout_marginTop="@dimen/tv_device_options_avatar_margin_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/tv_edit_screen_title_text_size"
            android:textColor="@color/tv_black_high_emphasis"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/contact_name"
            android:layout_width="@dimen/tv_edit_screen_input_text_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_edit_screen_title_margin_top"
            android:maxLines="1"
            android:layout_marginStart="@dimen/tv_edit_screen_input_text_margin_start_end"
            android:layout_marginEnd="@dimen/tv_edit_screen_input_text_margin_start_end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar_image_container"
            app:layout_constraintWidth_max="@dimen/tv_edit_screen_max_width"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tv_group_dropdown_container"
            android:layout_width="@dimen/tv_edit_screen_input_text_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_edit_screen_input_text_margin_top"
            android:hint="@string/tv_group_hint_text"
            app:layout_constraintEnd_toEndOf="@+id/contact_name"
            app:layout_constraintStart_toStartOf="@+id/contact_name"
            app:layout_constraintTop_toBottomOf="@+id/contact_name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
            <AutoCompleteTextView
                android:id="@+id/tv_group_dropdown"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:editable="false"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tv_description_field"
            android:layout_width="@dimen/tv_edit_screen_input_text_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_edit_screen_input_text_margin_top"
            android:hint="@string/tv_description_hint_text"
            app:layout_constraintEnd_toEndOf="@+id/contact_name"
            app:layout_constraintStart_toStartOf="@+id/contact_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_group_dropdown_container"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:gravity="start|top"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_edit_screen_description_title_height"
                android:inputType="textMultiLine"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/tv_delete_button_red"
            android:id="@+id/delete_button"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_edit_screen_delete_button_margin"
            android:text="@string/tv_delete_button_text"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/tv_delete_button_red"
            app:layout_constraintEnd_toEndOf="@+id/tv_description_field"
            app:layout_constraintStart_toStartOf="@+id/tv_description_field"
            app:layout_constraintTop_toBottomOf="@+id/tv_description_field"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/tv_edit_screen_delete_button_margin"
            app:layout_constraintEnd_toEndOf="@+id/contact_name"
            app:layout_constraintStart_toStartOf="@+id/contact_name"
            app:layout_constraintTop_toBottomOf="@+id/delete_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
