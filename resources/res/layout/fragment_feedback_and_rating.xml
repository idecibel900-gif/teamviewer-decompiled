<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollview"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RatingBar
            android:layout_gravity="center"
            android:id="@+id/rating_ratingbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:max="5"
            android:progress="2"
            android:stepSize="1"
            android:isIndicator="true"/>
        <TextView
            android:textSize="18sp"
            android:gravity="center"
            android:id="@+id/top_message_textview"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tv_feedback_IntroductionMessageNeutral"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">
            <RadioButton
                android:textSize="16sp"
                android:id="@+id/idea_radiobutton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/tv_feedback_ShareAnIdea"/>
            <RadioButton
                android:textSize="16sp"
                android:id="@+id/problem_radiobutton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tv_feedback_ReportAProblem"/>
        </RadioGroup>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/feedback_text_textinputlayout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="16dp"
            android:hint="@string/tv_feedback_TextDescriptionDefault"
            android:autoSizeTextType="none"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:enabled="true"
                android:textSize="16sp"
                android:gravity="top"
                android:id="@+id/feedback_text_textinput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:maxLength="@integer/maximum_feedback_text_length"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:textSize="14sp"
            android:id="@+id/feedback_hint_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/tv_feedback_ExplanatoryTextDefault"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/email_text_textinputlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:hint="@string/tv_feedback_EmailOptional"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:enabled="true"
                android:textSize="16sp"
                android:textColor="@color/color_blue"
                android:id="@+id/email_text_textinput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLength="256"/>
        </com.google.android.material.textfield.TextInputLayout>
        <Switch
            android:enabled="true"
            android:textSize="16sp"
            android:id="@+id/attach_log_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/tv_feedback_AttachLogFiles"/>
        <TextView
            android:textSize="14sp"
            android:id="@+id/attach_log_hint_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/tv_feedback_AttachLogFilesHint"/>
        <Button
            android:enabled="false"
            android:layout_gravity="center_horizontal"
            android:id="@+id/submit_feedback_button"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="16dp"
            android:text="@string/tv_feedback_SubmitFeedbackDefault"
            style="@style/Widget.AppCompat.Button.Colored"/>
        <Button
            android:layout_gravity="center_horizontal"
            android:id="@+id/submit_rating_only_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_feedback_SendRatingOnly"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
    </LinearLayout>
</ScrollView>
