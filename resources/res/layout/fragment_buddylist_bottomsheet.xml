<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/group_folder_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_folder_bottom_sheet"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/group_folder_id"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/group_folder_id"
            app:layout_constraintTop_toTopOf="@+id/group_folder_id">
            <TextView
                android:textSize="@dimen/bottom_sheet_title_text_size"
                android:textColor="@color/bottom_sheet_text_item_color_high_emphasis"
                android:ellipsize="end"
                android:id="@+id/group_title_bottom_sheet_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="@dimen/bottom_sheet_subtitle_text_size"
                android:textColor="@color/bottom_sheet_text_item_color_low_emphasis"
                android:id="@+id/group_members_number_bottom_sheet_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="@color/bottom_sheet_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.google.android.material.navigation.NavigationView
        android:layout_gravity="bottom"
        android:id="@+id/bottom_sheet_partner_list_nav_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemBackground="@color/bottom_sheet_fragment_background_color"
        app:menu="@menu/bottom_nav_drawer_buddylist_menu"/>
</LinearLayout>
