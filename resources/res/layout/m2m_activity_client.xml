<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/waiting_room"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/startup_help"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.teamviewer.remotecontrollib.gui.layout.TVClientRelativeLayout
        android:orientation="vertical"
        android:id="@+id/clientlayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/layout_client_image"/>
        <FrameLayout
            android:gravity="center_horizontal"
            android:id="@+id/specialKeyboardContainer"
            android:background="@color/m2m_special_keyboard_dark"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <com.teamviewer.remotecontrollib.gui.view.M2MSpecialKeyboard
                android:layout_gravity="center_horizontal"
                android:id="@+id/specialKeyboard"
                android:background="@color/m2m_special_keyboard_dark"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                app:keyBackground="@drawable/m2m_keyboard_selector"/>
        </FrameLayout>
        <com.teamviewer.remotecontrollib.gui.view.M2MZoomView
            android:id="@+id/m2m_zoomview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:src="@drawable/m2m_zoom_toogle"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="-4dp"
            android:layout_alignParentEnd="true"/>
        <com.teamviewer.remotecontrollib.gui.view.M2MControlView
            android:id="@+id/m2m_controlview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
        <com.teamviewer.remotecontrollib.gui.KeyboardInputView
            android:id="@+id/DummyKeyboardEdit"
            android:background="@android:color/transparent"
            android:layout_width="1px"
            android:layout_height="1px"
            android:layout_marginTop="0px"
            android:text=""
            android:inputType="textMultiLine"
            android:imeOptions="flagNoExtractUi"
            android:layout_marginStart="1px"/>
        <com.teamviewer.remotecontrolviewlib.view.session.InstructionsOverlayView
            android:id="@+id/m2m_instructions_overlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            app:instruction_target_view="@+id/m2m_zoomview"/>
    </com.teamviewer.remotecontrollib.gui.layout.TVClientRelativeLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/post_purchase_compose_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
