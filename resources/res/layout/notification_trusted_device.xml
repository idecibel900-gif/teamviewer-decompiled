<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textStyle="bold"
        android:id="@+id/trusted_device_notification_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_trusted_device_request_title_text"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
        android:id="@+id/trusted_device_request_teamviewer_id_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_trusted_device_request_teamviewer_id_text"
        android:layout_below="@+id/trusted_device_notification_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
        android:id="@+id/trusted_device_location_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_trusted_device_request_location_text"
        android:layout_below="@+id/trusted_device_request_teamviewer_id_text"/>
</RelativeLayout>
