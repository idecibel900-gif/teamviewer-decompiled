<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_bar_layout"
    android:background="@color/tv_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:stateListAnimator="@null">
    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:id="@+id/collapsing_toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:collapsedTitleTextAppearance="@style/ToolbarTitleCollapsed"
        app:contentScrim="?attr/colorPrimary"
        app:expandedTitleMarginBottom="@dimen/collapsing_toolbar_expanded_title_margin_bottom"
        app:expandedTitleMarginEnd="@dimen/collapsing_toolbar_expanded_title_margin_horizontal"
        app:expandedTitleMarginStart="@dimen/collapsing_toolbar_expanded_title_margin_horizontal"
        app:expandedTitleTextAppearance="@style/ToolbarTitleExpanded"
        app:titleEnabled="false">
        <FrameLayout
            android:id="@+id/expanded_toolbar_background"
            android:background="@drawable/partner_top_area_background"
            android:paddingBottom="@dimen/collapsing_toolbar_expanded_background_padding_bottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_collapseMode="parallax"/>
        <TextView
            android:textColor="@color/primary"
            android:layout_gravity="start|bottom"
            android:id="@+id/toolbar_subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/collapsing_toolbar_expanded_subtitle_margin"
            app:layout_collapseMode="parallax"
            style="@style/ToolbarSubtitle"/>
        <View
            android:id="@+id/expanded_toolbar_top_gradient"
            android:background="@drawable/toolbar_expanded_top_bottom_gradient"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_collapseMode="pin"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="22sp"
                android:textColor="@color/primary"
                android:gravity="center"
                android:id="@+id/central_label"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/tv_logo"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:scaleType="fitStart"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/teamviewer_logo_icon"/>
            <androidx.appcompat.widget.Toolbar
                android:theme="@style/ToolbarStyle"
                android:id="@+id/toolbar"
                android:layout_width="0dp"
                android:layout_height="?attr/actionBarSize"
                android:minHeight="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:navigationIcon="@drawable/navigation_back_icon"
                app:popupTheme="@style/ToolbarPopupStyle"
                app:titleTextAppearance="@style/ToolbarTitleCollapsed">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/toolbar_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/arrow_back_icon"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="32dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/navigation_back_icon"
                        app:tint="@color/primary"/>
                    <TextView
                        android:textSize="22sp"
                        android:textColor="@color/primary"
                        android:id="@+id/arrow_back_label"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/arrow_back_icon"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.appcompat.widget.Toolbar>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.CollapsingToolbarLayout>
</com.google.android.material.appbar.AppBarLayout>
