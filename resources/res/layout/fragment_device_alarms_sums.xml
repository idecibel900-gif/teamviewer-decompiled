<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/tv_white"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/tv_monitoring_alert_description_text_size"
        android:textColor="@color/monitoring_alert_text_low_emphasis"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/totalAlarmsText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/alarmsStatusIcon"
        app:layout_constraintBottom_toTopOf="@+id/device_information_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/tv_alert_overview_device_information_text_size"
        android:textColor="@color/monitoring_alert_device_information"
        android:gravity="center"
        android:id="@+id/device_information_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/tv_device_information_button_height"
        android:layout_marginTop="@dimen/tv_device_information_button_margin_top"
        android:layout_marginBottom="28dp"
        android:text="@string/tv_device_information"
        android:textAllCaps="true"
        android:layout_marginStart="@dimen/tv_device_alarms_sums_margin"
        android:layout_marginEnd="@dimen/tv_device_alarms_sums_margin"
        android:stateListAnimator="@null"
        android:letterSpacing="0"
        app:backgroundTint="@color/device_information_button_background"
        app:icon="@drawable/ic_information"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/tv_device_information_icon_padding"
        app:iconTint="@color/monitoring_alert_device_information"
        app:layout_constraintBottom_toTopOf="@+id/alarmsStatusIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/tv_device_alarms_sums_items_width"
        app:strokeColor="@color/monitoring_alert_device_information"
        app:strokeWidth="@dimen/tv_monitoring_alert_device_information_button_stroke"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/alarmsStatusIcon"
        android:layout_width="@dimen/tv_monitoring_alert_status_icon_height"
        android:layout_height="@dimen/tv_monitoring_alert_status_icon_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/alarmsText"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/tv_monitoring_alert_description_text_size"
        android:textColor="@color/monitoring_alert_text_low_emphasis"
        android:ellipsize="end"
        android:id="@+id/alarmsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/alarmsStatusIcon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/needsAttentionStatusIcon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/alarmsStatusIcon"
        app:layout_constraintTop_toTopOf="@+id/alarmsStatusIcon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/needsAttentionStatusIcon"
        android:layout_width="@dimen/tv_monitoring_alert_status_icon_height"
        android:layout_height="@dimen/tv_monitoring_alert_status_icon_height"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/needsAttentionText"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/alarmsText"/>
    <TextView
        android:textSize="@dimen/tv_monitoring_alert_description_text_size"
        android:textColor="@color/monitoring_alert_text_low_emphasis"
        android:ellipsize="end"
        android:id="@+id/needsAttentionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_toEndOf="@+id/needsAttentionStatusIcon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/needsAttentionStatusIcon"
        app:layout_constraintTop_toTopOf="@+id/needsAttentionStatusIcon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
