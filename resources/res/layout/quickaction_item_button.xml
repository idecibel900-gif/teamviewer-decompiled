<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="@dimen/bottom_sheet_content_list_item_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:gravity="start"
        android:id="@+id/list_item_dialog_button_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/bottom_sheet_content_list_item_left_padding"/>
    <TextView
        android:textColor="@android:color/black"
        android:gravity="start|bottom"
        android:layout_gravity="bottom"
        android:id="@+id/list_item_dialog_button_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/bottom_sheet_content_list_item_left_padding"
        android:layout_toEndOf="@+id/list_item_dialog_button_icon"/>
</RelativeLayout>
