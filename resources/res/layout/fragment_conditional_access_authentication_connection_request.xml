<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/conditional_access_authentication_padding_start_and_end"
        android:paddingEnd="@dimen/conditional_access_authentication_padding_start_and_end">
        <TextView
            android:textSize="@dimen/conditional_access_authentication_request_text_title"
            android:textStyle="bold"
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/conditional_access_authentication_request_margin_large"
            android:text="@string/tv_device_authentication_connection_request_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <ImageView
            android:id="@+id/device_from_image"
            android:layout_width="@dimen/conditional_access_authentication_request_icon_size"
            android:layout_height="@dimen/conditional_access_authentication_request_icon_size"
            android:src="@drawable/ic_device"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/grid_layout_one"
            app:layout_constraintStart_toStartOf="@+id/title_text"
            app:layout_constraintTop_toTopOf="@+id/grid_layout_one"/>
        <TextView
            android:textSize="@dimen/conditional_access_authentication_request_text_default"
            android:textStyle="bold"
            android:id="@+id/from_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/conditional_access_authentication_request_margin_medium"
            android:text="@string/tv_device_authentication_connection_request_from"
            android:layout_marginStart="@dimen/conditional_access_authentication_request_margin_small"
            app:layout_constraintStart_toEndOf="@+id/device_from_image"
            app:layout_constraintTop_toBottomOf="@+id/title_text"/>
        <GridLayout
            android:id="@+id/grid_layout_one"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/conditional_access_authentication_request_margin_title"
            android:rowCount="3"
            android:columnCount="2"
            android:useDefaultMargins="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/from_text"
            app:layout_constraintTop_toBottomOf="@+id/from_text">
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_column="0"
                android:text="@string/conditional_access_authentication_notification_content_text_account"
                android:singleLine="true"
                android:textIsSelectable="false"
                android:layout_row="0"
                android:layout_marginStart="0dp"/>
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:ellipsize="end"
                android:layout_gravity="fill_horizontal"
                android:id="@+id/from_account_data"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_column="1"
                android:textIsSelectable="true"
                android:layout_row="0"/>
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:text="@string/conditional_access_authentication_notification_content_text_device"
                android:singleLine="true"
                android:layout_row="1"
                android:layout_marginStart="0dp"/>
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:ellipsize="end"
                android:layout_gravity="fill_horizontal"
                android:id="@+id/from_device_data"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:textIsSelectable="true"
                android:layout_row="1"/>
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:text="@string/conditional_access_authentication_notification_content_text_company"
                android:singleLine="true"
                android:layout_row="2"
                android:layout_marginStart="0dp"/>
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:ellipsize="end"
                android:layout_gravity="fill_horizontal"
                android:id="@+id/from_company_data"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:textIsSelectable="true"
                android:layout_row="2"/>
        </GridLayout>
        <ImageView
            android:id="@+id/device_to_image"
            android:layout_width="@dimen/conditional_access_authentication_request_icon_size"
            android:layout_height="@dimen/conditional_access_authentication_request_icon_size"
            android:src="@drawable/ic_device"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/grid_layout_to"
            app:layout_constraintStart_toStartOf="@+id/device_from_image"
            app:layout_constraintTop_toTopOf="@+id/grid_layout_to"/>
        <TextView
            android:textSize="@dimen/conditional_access_authentication_request_text_default"
            android:textStyle="bold"
            android:ellipsize="end"
            android:id="@+id/to_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/conditional_access_authentication_request_margin_medium"
            android:text="@string/conditional_access_authentication_notification_content_text_receiver"
            android:singleLine="true"
            android:textIsSelectable="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/grid_layout_one"
            app:layout_constraintTop_toBottomOf="@+id/grid_layout_one"/>
        <GridLayout
            android:id="@+id/grid_layout_to"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/conditional_access_authentication_request_margin_title"
            android:rowCount="3"
            android:columnCount="2"
            android:useDefaultMargins="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/to_text"
            app:layout_constraintTop_toBottomOf="@+id/to_text">
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_column="0"
                android:text="@string/conditional_access_authentication_notification_content_text_account"
                android:singleLine="true"
                android:textIsSelectable="false"
                android:layout_row="0"
                android:layout_marginStart="0dp"/>
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:ellipsize="end"
                android:layout_gravity="fill_horizontal"
                android:id="@+id/to_account_data"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_column="1"
                android:textIsSelectable="true"
                android:layout_row="0"/>
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:text="@string/conditional_access_authentication_notification_content_text_device"
                android:singleLine="true"
                android:layout_row="1"
                android:layout_marginStart="0dp"/>
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:ellipsize="end"
                android:layout_gravity="fill_horizontal"
                android:id="@+id/to_device_data"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:textIsSelectable="true"
                android:layout_row="1"/>
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:text="@string/conditional_access_authentication_notification_content_text_company"
                android:singleLine="true"
                android:layout_row="2"
                android:layout_marginStart="0dp"/>
            <TextView
                android:textSize="@dimen/conditional_access_authentication_request_text_default"
                android:ellipsize="end"
                android:layout_gravity="fill_horizontal"
                android:id="@+id/to_company_data"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:textIsSelectable="true"
                android:layout_row="2"/>
        </GridLayout>
        <ImageView
            android:id="@+id/time_image"
            android:layout_width="@dimen/conditional_access_authentication_request_icon_size"
            android:layout_height="@dimen/conditional_access_authentication_request_icon_size"
            android:src="@drawable/ic_time"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/time_text"
            app:layout_constraintStart_toStartOf="@+id/device_to_image"
            app:layout_constraintTop_toTopOf="@+id/time_text"
            app:layout_constraintVertical_bias="0.5"/>
        <TextView
            android:textSize="@dimen/conditional_access_authentication_request_text_default"
            android:ellipsize="end"
            android:id="@+id/time_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/device_authentication_connection_request_margin_medium"
            android:textIsSelectable="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/grid_layout_to"
            app:layout_constraintTop_toBottomOf="@+id/grid_layout_to"/>
        <Button
            android:theme="@style/DeviceAuthenticationConnectionRequestDenyButton"
            android:textSize="@dimen/conditional_access_authentication_request_text_button"
            android:id="@+id/deny_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/conditional_access_authentication_request_button_height"
            android:layout_marginTop="@dimen/conditional_access_authentication_request_margin_large"
            android:text="@string/tv_device_authentication_connection_request_deny"
            android:layout_marginEnd="@dimen/conditional_access_authentication_request_margin_small"
            app:layout_constraintEnd_toStartOf="@+id/allow_button"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="@+id/time_image"
            app:layout_constraintTop_toBottomOf="@+id/time_text"/>
        <Button
            android:theme="@style/DeviceAuthenticationConnectionRequestAllowButton"
            android:textSize="@dimen/conditional_access_authentication_request_text_button"
            android:id="@+id/allow_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/conditional_access_authentication_request_button_height"
            android:text="@string/tv_device_authentication_connection_request_allow"
            app:layout_constraintBottom_toBottomOf="@+id/deny_button"
            app:layout_constraintEnd_toEndOf="@+id/title_text"
            app:layout_constraintStart_toEndOf="@+id/deny_button"
            app:layout_constraintTop_toTopOf="@+id/deny_button"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/conditional_access_authentication_request_margin_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/deny_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
