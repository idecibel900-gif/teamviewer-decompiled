<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/startup_help"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.teamviewer.remotecontrollib.gui.layout.TVClientRelativeLayout
        android:orientation="vertical"
        android:id="@+id/clientlayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/clientImage"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:layout_above="@+id/extraToolbarLayout"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true">
            <com.teamviewer.remotecontrollib.gui.ClientViewOpenGL
                android:id="@+id/clientView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <com.teamviewer.remotecontrollib.gui.KeyboardInputView
            android:id="@+id/DummyKeyboardEdit"
            android:background="@android:color/transparent"
            android:layout_width="1px"
            android:layout_height="1px"
            android:layout_marginTop="0px"
            android:text=""
            android:inputType="textMultiLine"
            android:imeOptions="flagNoExtractUi"
            android:layout_marginStart="1px"/>
        <com.teamviewer.remotecontrolviewlib.view.session.RcSessionExtraToolbarView
            android:id="@+id/extraToolbarLayout"
            android:background="@color/backgroundExtraToolbar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/toolbar_container"
            android:paddingStart="@dimen/extra_toolbar_horizontal_padding"
            android:paddingEnd="@dimen/extra_toolbar_horizontal_padding">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/toolbar_extra_start_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/toolbar_extra_end_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </com.teamviewer.remotecontrolviewlib.view.session.RcSessionExtraToolbarView>
        <TextView
            android:gravity="center_horizontal"
            android:id="@+id/promotion_badge"
            android:background="@drawable/gestures_promotion_badge"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="false"
            android:layout_above="@+id/toolbar_container"/>
        <FrameLayout
            android:id="@+id/toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <com.teamviewer.remotecontrolviewlib.view.session.RcSessionBottomToolbarView
                android:id="@+id/toolbar_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/rc_session_toolbar_height"/>
            <com.teamviewer.remotecontrollib.gui.TVSpecialKeyboard
                android:layout_gravity="center_horizontal"
                android:id="@+id/specialKeyboard"
                android:background="@color/special_keyboard_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/special_keyboard_height"
                android:paddingHorizontal="@dimen/special_keyboard_padding_horizontal"
                android:paddingVertical="@dimen/special_keyboard_padding_vertical"
                app:keyBackground="@drawable/keyboard_selector"
                app:keyTextColor="@color/special_keyboard_key_text"
                app:keyTextSize="22sp"
                app:labelTextSize="14sp"
                app:shadowRadius="0"/>
        </FrameLayout>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_gravity="end"
            android:id="@+id/session_showtoolbar"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fab_margin_bottom"
            android:src="@drawable/stoolbar_showtoolbar"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/fab_margin_horizontal"
            android:layout_marginEnd="@dimen/fab_margin_horizontal"
            android:layout_alignParentEnd="true"
            app:backgroundTint="@color/sessionFabColor"
            app:elevation="6dp"/>
    </com.teamviewer.remotecontrollib.gui.layout.TVClientRelativeLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/waiting_room"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/post_purchase_compose_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
