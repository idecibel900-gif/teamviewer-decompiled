<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/tv_white"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/alarmsStatusIcon"
        android:layout_width="@dimen/tv_monitoring_alert_status_icon_height"
        android:layout_height="@dimen/tv_monitoring_alert_status_icon_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/alarmsText"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/tv_monitoring_alert_description_text_size"
        android:textColor="@color/monitoring_alert_text_low_emphasis"
        android:ellipsize="end"
        android:id="@+id/alarmsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/alarmsStatusIcon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/needsAttentionStatusIcon"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/alarmsStatusIcon"
        app:layout_constraintTop_toTopOf="@+id/alarmsStatusIcon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/needsAttentionStatusIcon"
        android:layout_width="@dimen/tv_monitoring_alert_status_icon_height"
        android:layout_height="@dimen/tv_monitoring_alert_status_icon_height"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/needsAttentionText"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/alarmsText"/>
    <TextView
        android:textSize="@dimen/tv_monitoring_alert_description_text_size"
        android:textColor="@color/monitoring_alert_text_low_emphasis"
        android:ellipsize="end"
        android:id="@+id/needsAttentionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_toEndOf="@+id/needsAttentionStatusIcon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/needsAttentionStatusIcon"
        app:layout_constraintTop_toTopOf="@+id/needsAttentionStatusIcon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
