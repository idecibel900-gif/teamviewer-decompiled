<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nearby_device"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nearby_devices_dialog_expandable_list_item_size">
    <ImageView
        android:id="@+id/device_avatar_image"
        android:layout_width="@dimen/nearby_devices_dialog_device_picture_size"
        android:layout_height="@dimen/nearby_devices_dialog_device_picture_size"
        android:layout_marginLeft="@dimen/nearby_devices_dialog_device_picture_margin_left"
        android:layout_marginTop="@dimen/nearby_devices_dialog_device_picture_margin_top"
        android:layout_marginBottom="@dimen/nearby_devices_dialog_device_picture_margin_bottom"
        android:src="@drawable/device_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/nearby_device_status_icon"
        android:layout_width="@dimen/nearby_devices_dialog_device_picture_status_blip_size"
        android:layout_height="@dimen/nearby_devices_dialog_device_picture_status_blip_size"
        android:src="@drawable/online_indicator"
        android:layout_alignBottom="@+id/device_avatar_image"
        app:layout_constraintBottom_toBottomOf="@+id/device_avatar_image"
        app:layout_constraintEnd_toEndOf="@+id/device_avatar_image"/>
    <TextView
        android:textSize="@dimen/nearby_devices_dialog_device_text_size"
        android:textColor="@color/connect_dialog_nearby_devices_device_text_color"
        android:ellipsize="end"
        android:id="@+id/nearby_device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/nearby_devices_dialog_device_text_margin_left"
        android:lines="1"
        android:fontFamily="sans-serif-light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/nearby_add_btn"
        app:layout_constraintStart_toEndOf="@+id/device_avatar_image"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/nearby_add_btn"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="@dimen/nearby_devices_dialog_expandable_list_header_expand_icon_size"
        android:layout_height="@dimen/nearby_devices_dialog_expandable_list_header_expand_icon_size"
        android:src="@drawable/ic_nearby_plus"
        android:layout_marginEnd="@dimen/nearby_devices_dialog_expandable_list_header_expand_icon_margin_end"
        app:layout_constraintBottom_toBottomOf="@+id/nearby_device_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/nearby_device_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
