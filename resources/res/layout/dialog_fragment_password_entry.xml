<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerInParent="true">
    <TextView
        android:textSize="14sp"
        android:id="@+id/passInputTextView"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_passwordText"/>
    <EditText
        android:id="@+id/password_entry_text"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/tv_passwordHint"
        android:lines="1"
        android:layout_below="@+id/passInputTextView"
        android:inputType="textPassword"
        android:autofillHints="password"
        style="@style/TVDialogEditText"/>
</RelativeLayout>
