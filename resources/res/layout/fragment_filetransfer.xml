<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/filetransfer_list_margin_top"
    android:layout_marginBottom="@dimen/filetransfer_list_margin_bottom"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp">
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/ft_up_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:src="0x7f0800ea"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/filetransfer_list_margin_left"
        android:layout_marginEnd="8dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textColor="@color/colorTextBright"
        android:ellipsize="start"
        android:gravity="center_vertical"
        android:id="@+id/ft_breadcrumbs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:layout_alignBottom="@+id/ft_up_btn"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/filetransfer_list_margin_right"
        android:layout_toEndOf="@+id/ft_up_btn"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/colorTextBright"
        android:gravity="center"
        android:id="@+id/filetransfer_switch_to_local"
        android:background="@drawable/filetransfer_show_local_files_bg"
        android:paddingTop="@dimen/filetransfer_switch_vertical_padding"
        android:paddingBottom="@dimen/filetransfer_switch_vertical_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/filetransfer_switch_vertical_margin"
        android:layout_marginBottom="@dimen/filetransfer_switch_vertical_margin"
        android:text="@string/tv_filetransfer_switch_to_local"
        android:layout_alignParentBottom="true"
        android:paddingStart="25dp"
        android:paddingEnd="13dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/colorTextBright"
        android:gravity="center"
        android:id="@+id/filetransfer_switch_to_remote"
        android:background="@drawable/filetransfer_show_remote_files_bg"
        android:paddingTop="@dimen/filetransfer_switch_vertical_padding"
        android:paddingBottom="@dimen/filetransfer_switch_vertical_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/filetransfer_switch_vertical_margin"
        android:layout_marginBottom="@dimen/filetransfer_switch_vertical_margin"
        android:text="@string/tv_filetransfer_switch_to_remote"
        android:layout_alignParentBottom="true"
        android:paddingStart="13dp"
        android:paddingEnd="25dp"
        android:layout_alignParentEnd="true"/>
    <ListView
        android:id="@+id/fileList"
        android:background="@android:color/transparent"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@android:color/transparent"
        android:cacheColorHint="#00000000"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:choiceMode="singleChoice"
        android:fillViewport="true"
        android:layout_above="@+id/filetransfer_switch_to_remote"
        android:layout_below="@+id/ft_up_btn"
        android:overScrollFooter="@null"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"/>
    <TextView
        android:textAppearance="@android:style/TextAppearance.Small"
        android:textColor="@color/colorTextBright"
        android:gravity="center"
        android:id="@+id/filetransfer_bubble_switch_to_remote"
        android:background="@drawable/bubble_right"
        android:paddingTop="8dp"
        android:paddingBottom="23dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-12dp"
        android:text="@string/tv_filetransfer_bubble_to_remote"
        android:layout_above="@+id/filetransfer_switch_to_remote"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="@android:style/TextAppearance.Small"
        android:textColor="@color/colorTextBright"
        android:gravity="center"
        android:id="@+id/filetransfer_bubble_switch_to_local"
        android:background="@drawable/bubble_left"
        android:paddingTop="8dp"
        android:paddingBottom="23dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-12dp"
        android:text="@string/tv_filetransfer_bubble_to_local"
        android:layout_above="@+id/filetransfer_switch_to_local"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
