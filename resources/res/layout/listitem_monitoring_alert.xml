<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_monitoring_alert_container_height">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/monitoring_alert_background_acknowledge"
        android:background="@color/monitoring_alert_acknowledge_background_starting"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:alpha="0"
        app:layout_constraintEnd_toStartOf="@+id/acknowledgeEndGuideline"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/acknowledgeCheckbox"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/alert_acknowledge_tick_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/acknowledgeText"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/tv_monitoring_alert_background_text_size"
            android:textColor="#fff"
            android:id="@+id/acknowledgeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_acknowledge"
            android:layout_marginStart="@dimen/tv_monitoring_alert_background_text_image_margin"
            app:layout_constraintBottom_toBottomOf="@+id/acknowledgeCheckbox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/acknowledgeCheckbox"
            app:layout_constraintTop_toTopOf="@+id/acknowledgeCheckbox"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/acknowledgeEndGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.7"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/monitoring_alert_background_recheck"
        android:background="@color/monitoring_alert_recheck_background_starting"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/recheckStartGuideline">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/recheckCheckbox"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/alert_recheck_tick_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/recheckTxt"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/tv_monitoring_alert_background_text_size"
            android:textColor="#fff"
            android:id="@+id/recheckTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_recheck"
            android:layout_marginStart="@dimen/tv_monitoring_alert_background_text_image_margin"
            app:layout_constraintBottom_toBottomOf="@+id/recheckCheckbox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/recheckCheckbox"
            app:layout_constraintTop_toTopOf="@+id/recheckCheckbox"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/recheckStartGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.3"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/monitoring_alert_foreground"
        android:background="#ffffff"
        android:paddingTop="@dimen/tv_monitoring_alert_foreground_padding_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/alertsLogAcknowledgedStatusIcon"
            android:layout_width="@dimen/tv_monitoring_alert_status_icon_height"
            android:layout_height="@dimen/tv_monitoring_alert_status_icon_height"
            android:layout_marginStart="@dimen/tv_monitoring_alert_status_icon_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/tv_monitoring_alert_description_text_size"
            android:textColor="@color/monitoring_alert_text_high_emphasis"
            android:ellipsize="end"
            android:id="@+id/monitoringAlertDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/tv_monitoring_alert_foreground_text_margin"
            android:layout_toEndOf="@+id/alertsLogAcknowledgedStatusIcon"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="@+id/alertsLogAcknowledgedStatusIcon"
            app:layout_constraintEnd_toStartOf="@+id/alertTimeStamp"
            app:layout_constraintStart_toEndOf="@+id/alertsLogAcknowledgedStatusIcon"
            app:layout_constraintTop_toTopOf="@+id/alertsLogAcknowledgedStatusIcon"/>
        <TextView
            android:textSize="@dimen/tv_monitoring_alert_description_text_size"
            android:id="@+id/alertTimeStamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/monitoringAlertDesc"
            android:layout_marginEnd="@dimen/tv_monitoring_alert_timestamp_margin"
            app:layout_constraintBottom_toTopOf="@+id/monitoringAlertDesc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
