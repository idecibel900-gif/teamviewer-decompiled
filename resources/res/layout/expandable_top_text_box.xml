<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ExpandableTopTextBox">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/expandableTopTextBoxConstraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <ImageView
            android:id="@+id/expand_collapse_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/expandable_list_up_icon"
            android:layout_marginEnd="@dimen/expandable_top_text_box_toggle_icon_margin_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/expandable_top_text_box_icon_tint"/>
        <TextView
            android:id="@+id/digit_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/expandable_top_text_box_text_margin"
            android:layout_marginBottom="@dimen/expandable_top_text_box_text_margin"
            android:textIsSelectable="false"
            android:layout_marginStart="@dimen/expandable_top_text_box_text_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/expandable_top_text_box_text"
            android:ellipsize="end"
            android:autoLink="web"
            android:linksClickable="true"
            android:id="@+id/content_text_view"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textIsSelectable="false"
            android:layout_marginEnd="@dimen/expandable_top_text_box_text_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/expand_collapse_icon"
            app:layout_constraintStart_toEndOf="@+id/digit_text_view"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
