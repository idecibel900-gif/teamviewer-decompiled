<?xml version="1.0" encoding="utf-8"?>
<androidx.percentlayout.widget.PercentRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/chat_entry_padding"
    android:paddingTop="@dimen/chat_entry_padding"
    android:paddingRight="@dimen/list_margin_right"
    android:paddingBottom="@dimen/chat_entry_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/chat_entry_padding"
    android:paddingEnd="@dimen/list_margin_left">
    <RelativeLayout
        android:id="@+id/chat_incoming_container"
        android:background="@drawable/listitem_chat_message_incoming_background"
        android:paddingBottom="@dimen/chat_bubble_padding_corners"
        android:addStatesFromChildren="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/chat_incoming_layout_margin"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="@dimen/chat_incoming_layout_margin"
        android:layout_alignParentStart="true"
        android:backgroundTint="@color/tv_grey02"
        app:layout_widthPercent="60%">
        <RelativeLayout
            android:id="@+id/chat_message_thumbnail_container"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="@dimen/chat_message_thumbnail_margin"
            android:layout_marginRight="@dimen/chat_message_thumbnail_incoming_margin_right"
            android:layout_toRightOf="@+id/chat_account_avatar"
            android:layout_below="@+id/chat_group_partner_name"
            android:layout_alignParentRight="true"
            android:layout_toEndOf="@+id/chat_account_avatar">
            <ImageView
                android:id="@+id/chat_message_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/chat_message_thumbnail_margin"
                android:scaleType="fitCenter"
                android:foregroundGravity="center"
                android:contentDescription=""
                app:srcCompat="@drawable/file_thumbnail_placeholder"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/chat_message_thumbnail_overlay"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:scaleType="centerInside"
                android:layout_centerInParent="true"
                android:alpha="0.67"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/chat_file_message_textview"
            android:textColor="@color/tv_grey01"
            android:id="@+id/chat_group_partner_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/chat_group_partner_name_margin"
            android:layout_marginBottom="@dimen/chat_group_partner_name_margin"
            android:layout_toRightOf="@+id/chat_account_avatar"
            android:textIsSelectable="false"
            android:layout_marginStart="@dimen/chat_group_partner_name_margin"
            android:layout_toEndOf="@+id/chat_account_avatar"/>
        <TextView
            android:textSize="@dimen/chat_file_message_textview"
            android:textColor="@color/tv_black"
            android:id="@+id/chat_message_incoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/chat_group_partner_name_margin"
            android:layout_toRightOf="@+id/chat_account_avatar"
            android:layout_below="@+id/chat_message_thumbnail_container"
            android:textIsSelectable="false"
            android:layout_marginStart="@dimen/chat_group_partner_name_margin"
            android:layout_toEndOf="@+id/chat_account_avatar"
            android:layout_alignStart="@+id/chat_account_avatar"/>
        <com.teamviewer.avatarlib.view.RoundAvatarImageView
            android:id="@+id/chat_account_avatar"
            android:layout_width="@dimen/contact_placeholdersize_small"
            android:layout_height="@dimen/contact_placeholdersize_small"
            app:placeHolder="0x7f08006a"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/chat_timestamp_text_size"
        android:textColor="@color/tv_black"
        android:id="@+id/chat_incoming_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/chat_timestamp_margin"
        android:layout_toRightOf="@+id/chat_incoming_container"
        android:layout_alignBottom="@+id/chat_incoming_container"/>
</androidx.percentlayout.widget.PercentRelativeLayout>
