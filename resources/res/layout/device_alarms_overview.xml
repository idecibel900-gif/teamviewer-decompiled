<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/device_alarms_overview_recheckAllAlerts"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/avatar_image_container"
                    android:layout_width="@dimen/tv_device_avatar_size"
                    android:layout_height="@dimen/tv_device_avatar_size"
                    android:layout_marginTop="@dimen/tv_device_avatar_margin_top"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/tv_computer_name_text_size"
                    android:textColor="@color/tv_black_high_emphasis"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/partner_computer_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_computer_name_margin_top"
                    android:maxLines="1"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="@dimen/tv_computer_name_margins"
                    android:layout_marginEnd="@dimen/tv_computer_name_margins"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/avatar_image_container"
                    app:layout_constraintWidth_max="@dimen/tv_computer_name_max_text_width"/>
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/alerts_overview_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_alert_overview_container_margin_top"
                    app:layout_constraintTop_toBottomOf="@+id/partner_computer_name"/>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/alert_tabs"
                    android:background="@color/tv_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="3dp"
                    app:layout_constraintTop_toBottomOf="@+id/alerts_overview_container"
                    app:tabMode="fixed"
                    style="@style/alertFilterTabs"/>
                <FrameLayout
                    android:id="@+id/alerts_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/alert_tabs"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
