<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/tvdialog_padding_button_around"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/tv_comment_session_font_size_title"
        android:textColor="@android:color/white"
        android:id="@+id/commentSessionTextHeader"
        android:background="@color/tv_palette_blue_03"
        android:paddingTop="@dimen/tvdialog_padding_around_content_area"
        android:paddingBottom="@dimen/tvdialog_padding_between_title_and_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_comment_session_title"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/tvdialog_padding_around_content_area"
        android:paddingEnd="@dimen/tvdialog_padding_around_content_area"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/tv_comment_session_font_size_text"
        android:id="@+id/commentSessionTextDetailed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tv_comment_session_text_view_padding"
        android:layout_marginBottom="@dimen/tv_comment_session_text_view_padding"
        android:layout_below="@+id/commentSessionTextHeader"
        android:textIsSelectable="false"
        android:paddingStart="@dimen/tvdialog_padding_around_content_area"
        android:paddingEnd="@dimen/tvdialog_padding_around_content_area"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <EditText
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:gravity="start|top"
        android:id="@+id/commentSessionInputText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/tvdialog_padding_button_around"
        android:maxLength="@integer/tv_comment_session_max_comment_length"
        android:layout_above="@+id/buttonContainer"
        android:layout_below="@+id/commentSessionTextDetailed"
        android:inputType="textMultiLine"
        android:layout_marginStart="@dimen/tvdialog_padding_around_content_area"
        android:layout_marginEnd="@dimen/tvdialog_padding_around_content_area"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:importantForAutofill="no"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/tvdialog_padding_around_content_area"
        android:layout_marginEnd="@dimen/tvdialog_padding_around_content_area"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        app:alignItems="flex_end"
        app:flexDirection="row_reverse"
        app:flexWrap="wrap">
        <Button
            android:textColor="@android:color/white"
            android:id="@+id/buttonCommitComment"
            android:background="@color/tv_palette_blue_03"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tvdialog_button_height"
            android:minWidth="@dimen/tvdialog_flat_button_min_width"
            android:text="@string/tv_comment_session_commit"
            android:lines="1"
            android:paddingStart="@dimen/tvdialog_padding_button_intern"
            android:paddingEnd="@dimen/tvdialog_padding_button_intern"
            android:layout_marginStart="@dimen/tvdialog_padding_button_around"
            style="@style/Widget.AppCompat.Button.Colored"/>
        <Button
            android:textColor="@color/tv_palette_blue_03"
            android:id="@+id/buttonNoComment"
            android:background="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tvdialog_button_height"
            android:layout_marginTop="8dp"
            android:minWidth="@dimen/tvdialog_flat_button_min_width"
            android:text="@string/tv_comment_session_cancel"
            android:lines="1"
            android:height="@dimen/tvdialog_button_height"
            android:paddingStart="@dimen/tvdialog_padding_button_intern"
            android:paddingEnd="@dimen/tvdialog_padding_button_intern"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
    </com.google.android.flexbox.FlexboxLayout>
</RelativeLayout>
