<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/biometric_protection_promotion_guideline_start"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/biometric_protection_promotion_guideline_end"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/biometric_protection_promotion_scrollview_bottom_margin"
        android:fillViewport="true"
        android:fadeScrollbars="false"
        app:layout_constraintBottom_toTopOf="@+id/skip_button"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/guideline_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@dimen/biometric_protection_promotion_guideline_top"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_start_internal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@dimen/biometric_protection_promotion_guideline_start"
                app:layout_constraintTop_toBottomOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline_end_internal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@dimen/biometric_protection_promotion_guideline_end"
                app:layout_constraintTop_toBottomOf="parent"/>
            <ImageView
                android:id="@+id/bio_protect_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_bio_protection"
                android:layout_centerHorizontal="true"
                app:layout_constraintTop_toBottomOf="@+id/guideline_top"/>
            <TextView
                android:textSize="@dimen/biometric_protection_promotion_title_text_size"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/bio_protect_descprtion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/biometric_protection_promotion_scrollview_title_margin"
                android:text="@string/tv_biometric_protection_promotion_title"
                android:paddingStart="@dimen/biometric_protection_promotion_title_padding"
                android:paddingEnd="@dimen/biometric_protection_promotion_title_padding"
                app:layout_constraintEnd_toStartOf="@+id/guideline_end_internal"
                app:layout_constraintStart_toStartOf="@+id/guideline_start_internal"
                app:layout_constraintTop_toBottomOf="@+id/bio_protect_icon"/>
            <TextView
                android:textSize="@dimen/biometric_protection_promotion_body_text_size"
                android:id="@+id/switch_descprtion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/biometric_protection_promotion_description_top_margin"
                android:text="@string/tv_options_lock_menu"
                app:layout_constraintStart_toEndOf="@+id/guideline_start_internal"
                app:layout_constraintTop_toBottomOf="@+id/bio_protect_descprtion"/>
            <androidx.appcompat.widget.SwitchCompat
                android:theme="@style/TVSwitchStyle"
                android:id="@+id/switch_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:layout_alignParentEnd="true"
                app:layout_constraintEnd_toStartOf="@+id/guideline_end_internal"
                app:layout_constraintTop_toTopOf="@+id/switch_descprtion"/>
            <ImageView
                android:id="@+id/separator"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/biometric_protection_promotion_separator_margin"
                android:src="@drawable/radiobutton_group_divider"
                app:layout_constraintEnd_toStartOf="@+id/guideline_end_internal"
                app:layout_constraintStart_toStartOf="@+id/guideline_start_internal"
                app:layout_constraintTop_toBottomOf="@+id/switch_descprtion"/>
            <include
                android:id="@+id/protection_enabled_view_group"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/biometric_protection_promotion_list_top_margin"
                android:layout_marginBottom="@dimen/biometric_protection_promotion_separator_margin"
                app:layout_constraintEnd_toStartOf="@+id/guideline_end_internal"
                app:layout_constraintStart_toStartOf="@+id/guideline_start_internal"
                app:layout_constraintTop_toBottomOf="@+id/separator"
                layout="@layout/biometric_protection_promotion_buttongroup"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <Button
        android:textSize="@dimen/biometric_protection_promotion_button_text_size"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/skip_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/biometric_protection_promotion_hint_top_margin"
        app:layout_constraintBottom_toTopOf="@+id/set_in_future_description"
        app:layout_constraintEnd_toStartOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintWidth_max="@dimen/biometric_protection_promotion_button_max_width"/>
    <TextView
        android:textSize="@dimen/biometric_protection_promotion_button_hint_size"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/set_in_future_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tv_biometric_protection_promotion_hint"
        android:paddingStart="@dimen/biometric_protection_promotion_hint_padding"
        android:paddingEnd="@dimen/biometric_protection_promotion_hint_padding"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/biometric_protection_promotion_guideline_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
