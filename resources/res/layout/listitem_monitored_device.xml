<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_monitoring_alert_container_height">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/monitored_device_background_recheck"
        android:background="@color/monitoring_alert_recheck_background_starting"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/deviceRecheckStarGuideline">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/deviceRecheckCheckbox"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/alert_recheck_tick_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/deviceRecheckTxt"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/tv_monitoring_alert_background_text_size"
            android:textColor="#fff"
            android:id="@+id/deviceRecheckTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_recheck"
            android:layout_marginStart="@dimen/tv_monitoring_alert_background_text_image_margin"
            app:layout_constraintBottom_toBottomOf="@+id/deviceRecheckCheckbox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/deviceRecheckCheckbox"
            app:layout_constraintTop_toTopOf="@+id/deviceRecheckCheckbox"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/deviceRecheckStarGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.3"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/monitored_device_alert_foreground"
        android:background="#ffffff"
        android:paddingTop="@dimen/tv_monitoring_alert_foreground_padding_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/deviceAvatarIcon"
            android:layout_width="@dimen/tv_monitoring_alert_device_avatar_icon_height"
            android:layout_height="@dimen/tv_monitoring_alert_device_avatar_icon_height"
            android:layout_marginStart="@dimen/tv_monitoring_alert_status_icon_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/deviceStatusIcon"
            android:layout_width="@dimen/tv_monitoring_alert_status_bullet_icon_height"
            android:layout_height="@dimen/tv_monitoring_alert_status_bullet_icon_height"
            app:layout_constraintBottom_toBottomOf="@+id/deviceAvatarIcon"
            app:layout_constraintEnd_toEndOf="@+id/deviceAvatarIcon"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/monitored_device_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <TextView
            android:textSize="@dimen/tv_monitoring_alert_description_text_size"
            android:textColor="@color/monitoring_alert_text_high_emphasis"
            android:ellipsize="end"
            android:id="@+id/deviceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/tv_monitoring_alert_foreground_text_margin"
            app:layout_constraintBottom_toTopOf="@+id/monitored_device_guideline"
            app:layout_constraintEnd_toStartOf="@+id/barrier"
            app:layout_constraintStart_toEndOf="@+id/deviceAvatarIcon"/>
        <TextView
            android:textSize="@dimen/tv_monitoring_alert_subtitle_text_size"
            android:textColor="@color/monitoring_alert_text_low_emphasis"
            android:ellipsize="end"
            android:id="@+id/deviceSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_monitoring_alert_subtitle_margin_top"
            android:maxLines="1"
            android:layout_marginStart="@dimen/tv_monitoring_alert_foreground_text_margin"
            app:layout_constraintEnd_toStartOf="@+id/deviceLogAcknowledgedStatusIcon"
            app:layout_constraintStart_toEndOf="@+id/deviceAvatarIcon"
            app:layout_constraintTop_toBottomOf="@+id/monitored_device_guideline"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="left"
            app:constraint_referenced_ids="deviceAlertTimeStamp, deviceLogAcknowledgedStatusIcon"/>
        <TextView
            android:textSize="@dimen/tv_monitoring_alert_description_text_size"
            android:id="@+id/deviceAlertTimeStamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/tv_monitoring_alert_timestamp_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/deviceLogAcknowledgedStatusIcon"
            android:layout_width="@dimen/tv_monitoring_alert_status_icon_height"
            android:layout_height="@dimen/tv_monitoring_alert_status_icon_height"
            android:layout_marginEnd="@dimen/tv_monitoring_alert_status_icon_margin"
            app:layout_constraintBottom_toBottomOf="@+id/deviceSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/deviceTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
