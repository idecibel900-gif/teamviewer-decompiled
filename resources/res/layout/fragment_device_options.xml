<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.teamviewer.chatviewlib.view.RoundAccountPictureImageView
            android:id="@+id/avatar_image_container"
            android:layout_width="@dimen/tv_device_avatar_size"
            android:layout_height="@dimen/tv_device_avatar_size"
            android:layout_marginTop="@dimen/tv_device_options_avatar_margin_top"
            android:src="@drawable/device_icon"
            app:layout_constraintEnd_toEndOf="@+id/device_name"
            app:layout_constraintStart_toStartOf="@+id/device_name"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/computer_status"
            android:layout_width="@dimen/tv_status_indicator_size"
            android:layout_height="@dimen/tv_status_indicator_size"
            android:src="@drawable/offline_indicator"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_image_container"
            app:layout_constraintEnd_toEndOf="@+id/avatar_image_container"/>
        <TextView
            android:textSize="@dimen/tv_device_options_title_text_size"
            android:textColor="@color/tv_black_high_emphasis"
            android:gravity="center"
            android:id="@+id/device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_device_options_title_margin_top"
            android:layout_marginStart="@dimen/tv_device_options_margin"
            android:layout_marginEnd="@dimen/tv_device_options_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar_image_container"
            app:layout_constraintWidth_max="@dimen/tv_device_options_items_width"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/group_name_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_device_options_group_name_container_margin_top"
            app:layout_constraintEnd_toEndOf="@+id/device_name"
            app:layout_constraintStart_toStartOf="@+id/device_name"
            app:layout_constraintTop_toBottomOf="@+id/device_name">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_group_folder"/>
            <TextView
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/tv_gray_low_emphasis"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/group_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/tv_device_options_group_name_margin"
                android:layout_marginEnd="@dimen/tv_device_options_group_name_margin"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/groupNameBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="id_container, group_name_container"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/id_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_device_options_group_id_container_margin_top"
            app:layout_constraintEnd_toEndOf="@+id/device_name"
            app:layout_constraintStart_toStartOf="@+id/device_name"
            app:layout_constraintTop_toBottomOf="@+id/group_name_container">
            <TextView
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/tv_black_high_emphasis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_device_id"/>
            <TextView
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/tv_gray_low_emphasis"
                android:id="@+id/device_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tv_device_options_id_margin"/>
        </LinearLayout>
        <com.teamviewer.remotecontrolviewlib.layout.ExpandablePanel
            android:id="@+id/device_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/device_name"
            app:layout_constraintStart_toStartOf="@+id/device_name"
            app:layout_constraintTop_toBottomOf="@+id/groupNameBarrier"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/deviceInfoBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="device_description, id_container"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/actions_wrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_device_options_actions_spacing"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/device_name"
            app:layout_constraintStart_toStartOf="@+id/device_name"
            app:layout_constraintTop_toBottomOf="@+id/deviceInfoBarrier">
            <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/device_options_action_button_text_color"
                android:gravity="center"
                android:id="@+id/connect_with_password_button"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_device_options_actions_height"
                android:text="@string/tv_device_options_remote_control_btn"
                android:textAllCaps="true"
                android:letterSpacing="0"
                app:backgroundTint="@color/device_options_action_button_background"
                app:icon="@drawable/ic_remote_connection_white"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/tv_device_options_actions_icon_padding"
                app:iconTint="@color/device_options_action_button_icon_tint"
                app:strokeColor="@color/device_options_action_button_stroke_color"
                app:strokeWidth="@dimen/tv_device_options_actions_stroke"/>
            <TextView
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/pl_prompt_text_color"
                android:layout_gravity="center"
                android:id="@+id/connect_with_password_tooltip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tv_device_options_actions_spacing"
                android:text="@string/tv_device_options_rc_password_tooltip"/>
            <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/device_options_action_button_text_color"
                android:gravity="center"
                android:id="@+id/connect_with_prompt_button"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_device_options_actions_height"
                android:text="@string/tv_device_options_remote_control_btn"
                android:textAllCaps="true"
                android:letterSpacing="0"
                app:backgroundTint="@color/device_options_action_button_background"
                app:icon="@drawable/ic_remote_connection_password"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/tv_device_options_actions_icon_padding"
                app:iconTint="@color/device_options_action_button_icon_tint"
                app:strokeColor="@color/device_options_action_button_stroke_color"
                app:strokeWidth="@dimen/tv_device_options_actions_stroke"/>
            <TextView
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/pl_prompt_text_color"
                android:layout_gravity="center"
                android:id="@+id/connect_with_prompt_tooltip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tv_device_options_actions_spacing"
                android:text="@string/tv_device_options_rc_prompt_tooltip"/>
            <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/device_options_action_button_text_color"
                android:gravity="center"
                android:id="@+id/connect_with_remote_access"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_device_options_actions_height"
                android:layout_marginBottom="@dimen/tv_device_options_actions_spacing"
                android:text="@string/tv_device_options_remote_access_btn"
                android:textAllCaps="true"
                android:letterSpacing="0"
                app:backgroundTint="@color/device_options_action_button_background"
                app:icon="@drawable/ic_remote_access"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/tv_device_options_actions_icon_padding"
                app:iconTint="@color/device_options_action_button_icon_tint"
                app:strokeColor="@color/device_options_action_button_stroke_color"
                app:strokeWidth="@dimen/tv_device_options_actions_stroke"/>
            <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/device_options_action_button_text_color"
                android:gravity="center"
                android:id="@+id/file_transfer_button"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_device_options_actions_height"
                android:layout_marginBottom="@dimen/tv_device_options_actions_spacing"
                android:text="@string/tv_device_options_file_transfer_btn"
                android:textAllCaps="true"
                android:letterSpacing="0"
                app:backgroundTint="@color/device_options_action_button_background"
                app:icon="@drawable/ic_file_transfer"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/tv_device_options_actions_icon_padding"
                app:iconTint="@color/device_options_action_button_icon_tint"
                app:strokeColor="@color/device_options_action_button_stroke_color"
                app:strokeWidth="@dimen/tv_device_options_actions_stroke"/>
            <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/device_options_action_button_text_color"
                android:gravity="center"
                android:id="@+id/chat_button"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_device_options_actions_height"
                android:layout_marginBottom="@dimen/tv_device_options_actions_spacing"
                android:text="@string/tv_device_options_chat_btn"
                android:textAllCaps="true"
                android:letterSpacing="0"
                app:backgroundTint="@color/device_options_action_button_background"
                app:icon="@drawable/ic_chat"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/tv_device_options_actions_icon_padding"
                app:iconTint="@color/device_options_action_button_icon_tint"
                app:strokeColor="@color/device_options_action_button_stroke_color"
                app:strokeWidth="@dimen/tv_device_options_actions_stroke"/>
            <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/device_options_action_button_text_color"
                android:gravity="center"
                android:id="@+id/details_button"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_device_options_actions_height"
                android:layout_marginBottom="@dimen/tv_device_options_actions_spacing"
                android:text="@string/tv_device_options_details_alarms_btn"
                android:textAllCaps="true"
                android:letterSpacing="0"
                app:backgroundTint="@color/device_options_action_button_background"
                app:icon="@drawable/ic_details_and_alarms"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/tv_device_options_actions_icon_padding"
                app:iconTint="@color/device_options_action_button_icon_tint"
                app:strokeColor="@color/device_options_action_button_stroke_color"
                app:strokeWidth="@dimen/tv_device_options_actions_stroke"/>
            <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                android:textSize="@dimen/tv_device_options_device_info_text_size"
                android:textColor="@color/device_options_action_button_text_color"
                android:gravity="center"
                android:id="@+id/wake_up_button"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_device_options_actions_height"
                android:layout_marginBottom="@dimen/tv_device_options_actions_spacing"
                android:text="@string/tv_device_options_wake_up_btn"
                android:textAllCaps="true"
                android:letterSpacing="0"
                app:backgroundTint="@color/device_options_action_button_background"
                app:icon="@drawable/ic_wake_up"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/tv_device_options_actions_icon_padding"
                app:iconTint="@color/device_options_action_button_icon_tint"
                app:strokeColor="@color/device_options_action_button_stroke_color"
                app:strokeWidth="@dimen/tv_device_options_actions_stroke"/>
            <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                android:textColor="@color/device_options_action_button_text_color"
                android:gravity="center"
                android:id="@+id/shortcut_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_device_options_actions_height"
                android:layout_marginBottom="@dimen/tv_device_options_actions_spacing"
                android:text="@string/tv_device_options_home_screen_shortcut"
                android:maxLines="1"
                android:textAllCaps="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:letterSpacing="0"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="14sp"
                app:backgroundTint="@color/device_options_action_button_background"
                app:icon="@drawable/home_screen_shortcut_device_options_button"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/tv_device_options_actions_icon_padding"
                app:iconTint="@color/device_options_action_button_icon_tint"
                app:strokeColor="@color/device_options_action_button_stroke_color"
                app:strokeWidth="@dimen/tv_device_options_actions_stroke"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
