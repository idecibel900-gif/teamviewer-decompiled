<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/lock_screen_guideline_start"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/lock_screen_guideline_end"/>
    <ImageView
        android:id="@+id/lock_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bio_protection_locked"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/lockscreen_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:id="@+id/lockscreen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lock_screen_vertical_spacing"
        android:layout_marginBottom="@dimen/lock_screen_vertical_spacing"
        android:text="@string/tv_lockscreen_title"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/lockscreen_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lock_icon"
        style="@style/LockScreenHeadline"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/lockscreen_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lock_screen_vertical_spacing"
        android:layout_marginBottom="@dimen/lock_screen_description_bottom_margin"
        android:text="@string/tv_lockscreen_description"
        app:layout_constraintBottom_toTopOf="@+id/retry_auth"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lockscreen_title"
        style="@style/LockScreenBody"/>
    <Button
        android:textColor="@android:color/white"
        android:id="@+id/retry_auth"
        android:background="@drawable/solid_button_border"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lock_screen_button_top_margin"
        android:text="@string/tv_lockscreen_retry"
        app:layout_constraintBottom_toTopOf="@+id/lockscreen_guideline"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/lockscreen_description"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/lockscreen_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/lock_screen_guideline_mid"/>
    <Button
        android:id="@+id/reset_lock"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tv_lockscreen_reset"
        app:layout_constraintBottom_toTopOf="@+id/reset_description"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/lockscreen_guideline"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/LockScreenResetButton"/>
    <TextView
        android:textSize="@dimen/lock_screen_hint_size"
        android:gravity="center_horizontal"
        android:id="@+id/reset_description"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tv_lockscreen_reset_description"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/reset_lock"/>
</androidx.constraintlayout.widget.ConstraintLayout>
