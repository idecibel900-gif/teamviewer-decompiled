<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/predefined_shortcut_bottom_sheet_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/material_text_size_headline_6"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="fill_vertical"
        android:layout_gravity="fill_vertical"
        android:paddingTop="@dimen/bottom_sheet_content_top_padding"
        android:paddingBottom="@dimen/bottom_sheet_content_list_item_bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/tv_session_toolbar_info_button_title_shortcuts"
        android:drawableLeft="@drawable/predefined_shortcuts"
        android:drawablePadding="@dimen/bottom_sheet_content_drawable_padding"
        android:paddingStart="@dimen/bottom_sheet_content_left_padding"/>
    <ListView
        android:id="@+id/predefined_shortcuts_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
