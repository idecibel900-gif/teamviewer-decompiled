<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/filetransfer_list_margin_left"
    android:paddingEnd="@dimen/filetransfer_list_margin_right">
    <LinearLayout
        android:id="@+id/filetransfer_row"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:background="0x7f08019c"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">
            <ImageView
                android:id="@+id/filetransfer_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="2dp"
                android:src="0x7f080194"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/filetransfer_layout"
            android:background="@drawable/listitem_partner_content"
            android:padding="0dp"
            android:clickable="false"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/filetransfer_name"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="2dp"
                android:singleLine="true"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:paddingEnd="5dp"
                android:layout_marginStart="5dp"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/filetransfer_checkbox_layout"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <CheckBox
                    android:id="@+id/filetransfer_checkbox"
                    android:clickable="false"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@null"
                    android:layout_marginEnd="@dimen/checkbox_layout_margin_right"
                    style="@style/TVCheckbox"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
