<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/nearby_devices_dialog_expandable_list_header_text_size"
        android:textColor="@color/tv_black_high_emphasis"
        android:ellipsize="end"
        android:id="@+id/nearby_group_title"
        android:paddingTop="@dimen/nearby_devices_dialog_expandable_list_header_text_padding_top"
        android:paddingBottom="@dimen/nearby_devices_dialog_expandable_list_header_text_padding_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="@dimen/nearby_devices_dialog_expandable_list_header_text_padding_start"
        android:paddingEnd="@dimen/nearby_devices_dialog_expandable_list_header_text_padding_start"
        app:layout_constraintEnd_toStartOf="@+id/nearby_expandable_list_indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/nearby_expandable_list_indicator"
        android:background="@drawable/dialog_nearby_devices_group_indicator"
        android:layout_width="@dimen/nearby_devices_dialog_expandable_list_header_expand_icon_size"
        android:layout_height="@dimen/nearby_devices_dialog_expandable_list_header_expand_icon_size"
        android:layout_marginEnd="@dimen/nearby_devices_dialog_expandable_list_header_expand_icon_margin_end"
        app:layout_constraintBottom_toBottomOf="@+id/nearby_group_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
