<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/tv_device_information_top_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/frameLayout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/lineDivider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/avatar_image_container"
                android:layout_width="@dimen/tv_device_avatar_size"
                android:layout_height="@dimen/tv_device_avatar_size"
                android:layout_marginTop="@dimen/tv_device_information_avatar_margin_top"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/tv_device_information_title_text_size"
                android:textColor="@color/tv_black_high_emphasis"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/alarm_details_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_alarm_details_title_margin_top"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/tv_alarm_details_title_margin_start_end"
                android:layout_marginEnd="@dimen/tv_alarm_details_title_margin_start_end"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/avatar_image_container"
                app:layout_constraintWidth_max="@dimen/tv_alarm_details_items_width"/>
            <View
                android:background="@color/tv_white"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/actions_wrapper"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frameLayout"/>
            <View
                android:id="@+id/lineDivider"
                android:background="@color/monitoring_alert_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/tv_alarm_details_separator_margin_top"
                app:layout_constraintTop_toBottomOf="@+id/alarm_details_device_name"/>
            <TextView
                android:textSize="@dimen/tv_alarm_details_subtitle_text_size"
                android:textColor="@color/tv_alarms_details_subtitle_text_color"
                android:id="@+id/device_alarm_details_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_alarm_details_subtitle_margin_top"
                android:text="@string/tv_alarm_details_subtitle"
                app:layout_constraintEnd_toEndOf="@+id/alarm_details_device_name"
                app:layout_constraintStart_toStartOf="@+id/alarm_details_device_name"
                app:layout_constraintTop_toBottomOf="@+id/lineDivider"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/alertsLogAcknowledgedStatusIcon"
                android:layout_width="@dimen/tv_monitoring_alert_status_icon_height"
                android:layout_height="@dimen/tv_monitoring_alert_status_icon_height"
                app:layout_constraintBottom_toBottomOf="@+id/alertSubtitle"
                app:layout_constraintStart_toStartOf="@+id/device_alarm_details_subtitle"
                app:layout_constraintTop_toTopOf="@+id/alertTitle"/>
            <TextView
                android:textSize="@dimen/tv_monitoring_alert_description_text_size"
                android:textColor="@color/monitoring_alert_text_high_emphasis"
                android:id="@+id/alertTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_alarm_details_alert_title_margin_top"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/tv_alarm_details_alert_title_margin_start"
                app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                app:layout_constraintStart_toEndOf="@+id/alertsLogAcknowledgedStatusIcon"
                app:layout_constraintTop_toBottomOf="@+id/device_alarm_details_subtitle"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="@dimen/tv_monitoring_alert_subtitle_text_size"
                android:textColor="@color/monitoring_alert_text_low_emphasis"
                android:ellipsize="end"
                android:id="@+id/alertSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:layout_marginStart="@dimen/tv_alarm_details_alert_subtitle_margin_start"
                app:layout_constraintEnd_toEndOf="@+id/device_alarm_details_subtitle"
                app:layout_constraintStart_toEndOf="@+id/alertsLogAcknowledgedStatusIcon"
                app:layout_constraintTop_toBottomOf="@+id/alertTitle"
                app:layout_constraintVertical_chainStyle="packed"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/actions_wrapper"
                android:paddingTop="@dimen/tv_alarm_details_actions_wrapper_padding_top"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_alarm_details_actions_spacing"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/alarm_details_device_name"
                app:layout_constraintStart_toStartOf="@+id/alarm_details_device_name"
                app:layout_constraintTop_toBottomOf="@+id/alertSubtitle">
                <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                    android:textSize="@dimen/tv_alarm_details_device_info_text_size"
                    android:textColor="@color/device_options_action_button_text_color"
                    android:gravity="center"
                    android:id="@+id/connect_with_password_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tv_alarm_details_actions_height"
                    android:text="@string/tv_device_options_remote_control_btn"
                    android:textAllCaps="true"
                    android:letterSpacing="0"
                    app:backgroundTint="@color/device_options_action_button_background"
                    app:icon="@drawable/ic_remote_connection_white"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/tv_alarm_details_actions_icon_padding"
                    app:iconTint="@color/device_options_action_button_icon_tint"
                    app:strokeColor="@color/device_options_action_button_stroke_color"
                    app:strokeWidth="@dimen/tv_alarm_details_actions_stroke"/>
                <TextView
                    android:textSize="@dimen/tv_alarm_details_device_info_text_size"
                    android:textColor="@color/pl_prompt_text_color"
                    android:layout_gravity="center"
                    android:id="@+id/connect_with_password_tooltip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/tv_alarm_details_actions_spacing"
                    android:text="@string/tv_device_options_rc_password_tooltip"/>
                <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                    android:textSize="@dimen/tv_alarm_details_device_info_text_size"
                    android:textColor="@color/device_options_action_button_text_color"
                    android:gravity="center"
                    android:id="@+id/connect_with_prompt_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tv_alarm_details_actions_height"
                    android:text="@string/tv_device_options_remote_control_btn"
                    android:textAllCaps="true"
                    android:letterSpacing="0"
                    app:backgroundTint="@color/device_options_action_button_background"
                    app:icon="@drawable/ic_remote_connection_password"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/tv_device_options_actions_icon_padding"
                    app:iconTint="@color/device_options_action_button_icon_tint"
                    app:strokeColor="@color/device_options_action_button_stroke_color"
                    app:strokeWidth="@dimen/tv_alarm_details_actions_stroke"/>
                <TextView
                    android:textSize="@dimen/tv_alarm_details_device_info_text_size"
                    android:textColor="@color/pl_prompt_text_color"
                    android:layout_gravity="center"
                    android:id="@+id/connect_with_prompt_tooltip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/tv_alarm_details_actions_spacing"
                    android:text="@string/tv_device_options_rc_prompt_tooltip"/>
                <com.teamviewer.remotecontrolviewlib.view.partnerlist.DeviceOptionsActionButton
                    android:textSize="@dimen/tv_alarm_details_device_info_text_size"
                    android:textColor="@color/device_options_action_button_text_color"
                    android:gravity="center"
                    android:id="@+id/chat_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tv_alarm_details_actions_height"
                    android:layout_marginBottom="@dimen/tv_alarm_details_actions_spacing"
                    android:text="@string/tv_device_options_chat_btn"
                    android:textAllCaps="true"
                    android:letterSpacing="0"
                    app:backgroundTint="@color/device_options_action_button_background"
                    app:icon="@drawable/ic_chat"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/tv_alarm_details_actions_icon_padding"
                    app:iconTint="@color/device_options_action_button_icon_tint"
                    app:strokeColor="@color/device_options_action_button_stroke_color"
                    app:strokeWidth="@dimen/tv_alarm_details_actions_stroke"/>
            </LinearLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/tv_alarm_details_subtitle_margin_top"
                app:layout_constraintEnd_toEndOf="@+id/alarm_details_device_name"
                app:layout_constraintStart_toStartOf="@+id/alarm_details_device_name"
                app:layout_constraintTop_toBottomOf="@+id/actions_wrapper"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
