<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/MaterialAppTheme"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.teamviewer.remotecontrolviewlib.layout.TVTabOutsideLinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/partner_edit_properties_list_padding_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tv_sessionCode"
            style="@style/MaterialTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editInstantSupportId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textShortMessage"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tv_assignee"
            style="@style/MaterialTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editInstantSupportAssignee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textShortMessage"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tv_buddyGroup"
            style="@style/MaterialTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPartnerGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textShortMessage"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tv_serviceCaseDescription"
            style="@style/MaterialTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editInstantSupportNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"/>
        </com.google.android.material.textfield.TextInputLayout>
    </com.teamviewer.remotecontrolviewlib.layout.TVTabOutsideLinearLayout>
</androidx.core.widget.NestedScrollView>
