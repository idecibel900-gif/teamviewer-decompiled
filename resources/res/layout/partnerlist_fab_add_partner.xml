<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end|bottom"
    android:paddingBottom="@dimen/fab_margin_bottom"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/fab_margin_horizontal"
    android:paddingEnd="@dimen/fab_margin_horizontal">
    <TextView
        android:id="@+id/pl_nearby_search_label"
        android:layout_column="0"
        android:text="@string/tv_fab_nearby"
        android:layout_row="0"
        style="@style/FabSecondaryLabel"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/pl_nearby_search"
        android:layout_column="1"
        android:layout_row="0"
        app:fabCustomSize="42dp"
        app:maxImageSize="42dp"
        app:srcCompat="@drawable/ic_nearby"
        style="@style/FabSecondary"/>
    <TextView
        android:id="@+id/pl_group_add_group_label"
        android:layout_marginTop="@dimen/fab_secondary_margin_top"
        android:layout_column="0"
        android:text="@string/tv_fab_add_group"
        android:layout_row="1"
        style="@style/FabSecondaryLabel"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/pl_group_add_group"
        android:layout_marginTop="@dimen/fab_secondary_margin_top"
        android:layout_column="1"
        android:layout_row="1"
        app:fabCustomSize="42dp"
        app:maxImageSize="42dp"
        app:srcCompat="@drawable/ic_group_add"
        style="@style/FabSecondary"/>
    <TextView
        android:id="@+id/pl_group_add_computer_label"
        android:layout_marginTop="@dimen/fab_secondary_margin_top"
        android:layout_column="0"
        android:text="@string/tv_fab_add_computer"
        android:layout_row="2"
        style="@style/FabSecondaryLabel"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/pl_group_add_computer"
        android:layout_marginTop="@dimen/fab_secondary_margin_top"
        android:layout_column="1"
        android:layout_row="2"
        app:fabCustomSize="42dp"
        app:maxImageSize="42dp"
        app:srcCompat="@drawable/device_image_without_status"
        style="@style/FabSecondary"/>
    <TextView
        android:id="@+id/pl_group_add_contact_label"
        android:layout_marginTop="@dimen/fab_secondary_margin_top"
        android:layout_column="0"
        android:text="@string/tv_fab_add_contact"
        android:layout_row="3"
        style="@style/FabSecondaryLabel"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/pl_group_add_contact"
        android:layout_marginTop="@dimen/fab_secondary_margin_top"
        android:layout_column="1"
        android:layout_row="3"
        app:fabCustomSize="42dp"
        app:maxImageSize="42dp"
        app:srcCompat="@drawable/user_placeholder_image"
        style="@style/FabSecondary"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/pl_group_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fab_margin_top"
        android:tint="@color/fabIconColor"
        android:layout_column="1"
        android:layout_row="4"
        app:backgroundTint="@color/fabColor"
        app:srcCompat="@drawable/add_icon_white"/>
</GridLayout>
