<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/trusted_device_request_padding_start_and_end"
        android:paddingEnd="@dimen/trusted_device_request_padding_start_and_end">
        <ImageView
            android:textStyle="bold"
            android:id="@+id/trusted_device_request_device_from_imageview"
            android:layout_width="@dimen/trusted_device_request_icon_size"
            android:layout_height="@dimen/trusted_device_request_icon_size"
            android:layout_marginTop="@dimen/trusted_device_request_margin_large"
            android:src="@drawable/ic_device"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/trusted_device_request_title_textview"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <TextView
            android:textSize="@dimen/trusted_device_request_text_size_default"
            android:textStyle="bold"
            android:id="@+id/trusted_device_request_from_teamviewer_id_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/tv_trusted_device_request_device_name_text"
            android:textIsSelectable="true"
            android:layout_marginStart="@dimen/trusted_device_request_margin_small"
            app:layout_constraintBottom_toBottomOf="@+id/trusted_device_request_device_from_imageview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/trusted_device_request_device_from_imageview"
            app:layout_constraintTop_toTopOf="@+id/trusted_device_request_device_from_imageview"/>
        <ImageView
            android:id="@+id/trusted_device_request_location_imageview"
            android:layout_width="@dimen/trusted_device_request_icon_size"
            android:layout_height="@dimen/trusted_device_request_icon_size"
            android:src="@drawable/ic_location"
            app:layout_constraintBottom_toBottomOf="@+id/trusted_device_request_ip_address_textview"
            app:layout_constraintEnd_toEndOf="@+id/trusted_device_request_device_from_imageview"
            app:layout_constraintStart_toStartOf="@+id/trusted_device_request_device_from_imageview"
            app:layout_constraintTop_toTopOf="@+id/trusted_device_request_location_textview"/>
        <TextView
            android:textSize="@dimen/trusted_device_request_text_size_default"
            android:textStyle="bold"
            android:id="@+id/trusted_device_request_location_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/trusted_device_request_margin_small"
            android:textIsSelectable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/trusted_device_request_from_teamviewer_id_textview"
            app:layout_constraintTop_toBottomOf="@+id/trusted_device_request_from_teamviewer_id_textview"/>
        <TextView
            android:textSize="@dimen/trusted_device_request_text_size_default"
            android:id="@+id/trusted_device_request_ip_address_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/trusted_device_request_margin_tiny"
            android:textIsSelectable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/trusted_device_request_location_textview"
            app:layout_constraintTop_toBottomOf="@+id/trusted_device_request_location_textview"/>
        <ImageView
            android:id="@+id/trusted_device_request_time_imageview"
            android:layout_width="@dimen/trusted_device_request_icon_size"
            android:layout_height="@dimen/trusted_device_request_icon_size"
            android:src="@drawable/ic_time"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/trusted_device_request_date_textview"
            app:layout_constraintEnd_toEndOf="@+id/trusted_device_request_device_from_imageview"
            app:layout_constraintStart_toStartOf="@+id/trusted_device_request_device_from_imageview"
            app:layout_constraintTop_toTopOf="@+id/trusted_device_request_time_textview"/>
        <TextView
            android:textSize="@dimen/trusted_device_request_text_size_default"
            android:textStyle="bold"
            android:id="@+id/trusted_device_request_time_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/trusted_device_request_margin_small"
            android:textIsSelectable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/trusted_device_request_ip_address_textview"
            app:layout_constraintTop_toBottomOf="@+id/trusted_device_request_ip_address_textview"/>
        <TextView
            android:textSize="@dimen/trusted_device_request_text_size_default"
            android:id="@+id/trusted_device_request_date_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/trusted_device_request_margin_tiny"
            android:textIsSelectable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/trusted_device_request_time_textview"
            app:layout_constraintTop_toBottomOf="@+id/trusted_device_request_time_textview"/>
        <TextView
            android:textSize="@dimen/trusted_device_request_text_size_title"
            android:textStyle="bold"
            android:id="@+id/trusted_device_request_title_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/trusted_device_request_margin_medium"
            android:text="@string/tv_trusted_device_request_heading_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trusted_device_request_date_textview"/>
        <RadioGroup
            android:id="@+id/trusted_device_RadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/trusted_device_this_device_radiobutton"
            app:layout_constraintStart_toStartOf="@+id/trusted_device_request_title_textview"
            app:layout_constraintTop_toBottomOf="@+id/trusted_device_request_title_textview">
            <RadioButton
                android:textSize="@dimen/trusted_device_request_text_size_default"
                android:id="@+id/trusted_device_this_device_radiobutton"
                android:paddingLeft="@dimen/trusted_device_request_radio_button_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/trusted_device_request_margin_small"
                android:minHeight="@dimen/trusted_device_request_radio_button_height"
                android:text="@string/tv_trusted_device_option_this_device_text"/>
            <RadioButton
                android:textSize="@dimen/trusted_device_request_text_size_default"
                android:id="@+id/trusted_device_this_ip_address_radiobutton"
                android:paddingLeft="@dimen/trusted_device_request_radio_button_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/trusted_device_request_radio_button_height"
                android:text="@string/tv_trusted_device_option_this_ip_address_text"/>
            <RadioButton
                android:textSize="@dimen/trusted_device_request_text_size_default"
                android:id="@+id/trusted_device_only_once_radiobutton"
                android:paddingLeft="@dimen/trusted_device_request_radio_button_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/trusted_device_request_radio_button_height"
                android:text="@string/tv_trusted_device_option_only_once_text"/>
        </RadioGroup>
        <Button
            android:theme="@style/DeviceAuthenticationConnectionRequestDenyButton"
            android:textSize="@dimen/trusted_device_request_text_size_button"
            android:id="@+id/trusted_device_request_decline_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/trusted_device_request_button_height"
            android:layout_marginTop="@dimen/trusted_device_request_margin_medium"
            android:layout_marginBottom="@dimen/trusted_device_request_margin_medium"
            android:text="@string/tv_trusted_device_request_decline_text"
            android:singleLine="true"
            android:layout_marginEnd="@dimen/trusted_device_request_margin_tiny"
            app:layout_constraintEnd_toStartOf="@+id/trusted_device_request_trust_button"
            app:layout_constraintStart_toStartOf="@+id/trusted_device_RadioGroup"
            app:layout_constraintTop_toBottomOf="@+id/trusted_device_RadioGroup"/>
        <Button
            android:theme="@style/DeviceAuthenticationConnectionRequestAllowButton"
            android:textSize="@dimen/trusted_device_request_text_size_button"
            android:id="@+id/trusted_device_request_trust_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/trusted_device_request_button_height"
            android:layout_marginTop="@dimen/trusted_device_request_margin_medium"
            android:layout_marginBottom="@dimen/trusted_device_request_margin_medium"
            android:text="@string/tv_trusted_device_request_trust_text"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="@+id/trusted_device_request_title_textview"
            app:layout_constraintStart_toEndOf="@+id/trusted_device_request_decline_button"
            app:layout_constraintTop_toBottomOf="@+id/trusted_device_RadioGroup"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/trusted_device_request_spacer_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trusted_device_request_decline_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
