<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textStyle="bold"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conditional_access_authentication_notification_content_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textStyle="italic"
        android:id="@+id/from"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conditional_access_authentication_notification_content_text_sender"
        android:layout_below="@+id/title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:ellipsize="end"
        android:id="@+id/from_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/title"
        android:textIsSelectable="true"
        android:layout_marginStart="5sp"
        android:layout_toEndOf="@+id/from"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textStyle="italic"
        android:id="@+id/to"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conditional_access_authentication_notification_content_text_receiver"
        android:layout_below="@+id/title"
        android:layout_marginStart="5sp"
        android:layout_toEndOf="@+id/from_data"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:ellipsize="end"
        android:id="@+id/to_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/title"
        android:textIsSelectable="true"
        android:layout_marginStart="5sp"
        android:layout_toEndOf="@+id/to"/>
</RelativeLayout>
