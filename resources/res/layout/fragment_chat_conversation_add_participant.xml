<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/chat_conversation_recipients_container"
        android:visibility="visible"
        layout="@layout/layout_chat_conversation_recipients_container"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_conversation_recyclerview"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/chat_conversation_recipients_container"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
