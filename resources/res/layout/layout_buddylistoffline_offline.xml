<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/buddy_list_offline_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/buddy_list_account_common_background"
        android:paddingTop="@dimen/buddy_list_account_offline_container_min_padding_top"
        android:paddingBottom="@dimen/buddy_list_account_common_container_min_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/PartnerlistAccountHorizontalPadding">
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="@integer/buddy_list_account_offline_content_blank_space_weight_top"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/buddy_list_account_offline_distance_between_image_and_text_header"
            android:src="0x7f08008b"
            android:layout_marginStart="@dimen/buddy_list_account_common_component_min_margin_horizontal"
            android:layout_marginEnd="@dimen/buddy_list_account_common_component_min_margin_horizontal"/>
        <TextView
            android:textSize="@dimen/buddy_list_account_offline_offline_header_text_size"
            android:textColor="@color/buddy_list_account_common_text_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/buddy_list_offline_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/buddy_list_account_offline_distance_between_text_header_and_explanation"
            android:layout_marginStart="@dimen/buddy_list_account_common_component_min_margin_horizontal"
            android:layout_marginEnd="@dimen/buddy_list_account_common_component_min_margin_horizontal"/>
        <TextView
            android:textSize="@dimen/buddy_list_account_offline_explanation_text_size"
            android:textColor="@color/buddy_list_account_common_text_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/buddy_list_offline_explanation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/buddy_list_account_common_component_min_margin_horizontal"
            android:layout_marginEnd="@dimen/buddy_list_account_common_component_min_margin_horizontal"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="@integer/buddy_list_account_offline_content_blank_space_weight_bottom"/>
    </LinearLayout>
</ScrollView>
