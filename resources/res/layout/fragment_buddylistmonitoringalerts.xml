<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/alerts_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/image_tick"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_gray_tick"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/empty_alerts"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        app:layout_constraintEnd_toEndOf="@+id/image_tick"
        app:layout_constraintStart_toStartOf="@+id/image_tick"
        app:layout_constraintTop_toBottomOf="@+id/image_tick"/>
    <Space
        android:id="@+id/empty_space"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="39dp"
        app:layout_constraintEnd_toEndOf="@+id/empty_alerts"
        app:layout_constraintStart_toStartOf="@+id/empty_alerts"
        app:layout_constraintTop_toBottomOf="@+id/empty_alerts"/>
    <View
        android:id="@+id/alerts_list_mask"
        android:focusable="true"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/alerts_list"
        app:layout_constraintEnd_toEndOf="@+id/alerts_list"
        app:layout_constraintStart_toStartOf="@+id/alerts_list"
        app:layout_constraintTop_toTopOf="@+id/alerts_list"/>
</androidx.constraintlayout.widget.ConstraintLayout>
