<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@android:style/TextAppearance.Small"
        android:textColor="@color/colorTextBright"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/filetransfer_bubble_clip"
        android:background="@drawable/bubble_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_filetransfer_bubble_clip"
        android:paddingStart="12dp"
        android:paddingEnd="24dp"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:id="@+id/filetransfer_clip"
        android:background="@drawable/filetransfer_clip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@drawable/filetransfer_clip"
            android:gravity="center"
            android:id="@+id/clip_selectioncount"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="25dp"/>
    </LinearLayout>
</LinearLayout>
