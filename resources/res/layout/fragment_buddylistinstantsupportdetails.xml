<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PartnerDetailsPropertyItem">
            <TextView
                android:textSize="@dimen/partner_details_properties_primary_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tv_sessionCode"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/partner_details_properties_secondary_text_size"
                android:textColor="@color/colorTextListItemSecondary"
                android:id="@+id/instantSupport_displayId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PartnerDetailsPropertyItem">
            <TextView
                android:textSize="@dimen/partner_details_properties_primary_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tv_assignee"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/partner_details_properties_secondary_text_size"
                android:textColor="@color/colorTextListItemSecondary"
                android:id="@+id/instantSupport_assignee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PartnerDetailsPropertyItem">
            <TextView
                android:textSize="@dimen/partner_details_properties_primary_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tv_buddyGroup"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/partner_details_properties_secondary_text_size"
                android:textColor="@color/colorTextListItemSecondary"
                android:id="@+id/instantSupport_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PartnerDetailsPropertyItem">
            <TextView
                android:textSize="@dimen/partner_details_properties_primary_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tv_serviceCaseDescription"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/partner_details_properties_secondary_text_size"
                android:textColor="@color/colorTextListItemSecondary"
                android:id="@+id/instantSupport_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textAlignment="viewStart"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
