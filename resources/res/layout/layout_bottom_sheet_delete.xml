<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/delete_icon_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_bottom_sheet_delete"/>
    <TextView
        android:textSize="@dimen/bottom_sheet_title_text_size"
        android:textColor="@color/bottom_sheet_text_item_color_low_emphasis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_partner_menu_delete"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/delete_icon_id"
        app:layout_constraintStart_toEndOf="@+id/delete_icon_id"
        app:layout_constraintTop_toTopOf="@+id/delete_icon_id"/>
</androidx.constraintlayout.widget.ConstraintLayout>
