<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/monitoring_overview_recheckAllAlerts"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/device_avatar_image"
                    android:layout_width="@dimen/tv_endpoints_monitor_icon_size"
                    android:layout_height="@dimen/tv_endpoints_monitor_icon_size"
                    android:src="@drawable/monitoring_overview_icon"/>
                <TextView
                    android:textSize="@dimen/tv_computer_name_text_size"
                    android:textColor="@color/tv_black_high_emphasis"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_endpoints_usage"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="@dimen/tv_endpoints_in_use_text_size"
                    android:textColor="@color/tv_gray_low_emphasis"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/computers_in_use"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_endpoints_in_use_margin_top"
                    android:layout_marginBottom="@dimen/tv_endpoints_in_use_margin_bottom"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-regular"/>
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/alerts_overview_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/alert_tabs"
                    android:background="@color/tv_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="3dp"
                    app:tabMode="fixed"
                    style="@style/alertFilterTabs"/>
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/alerts_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
