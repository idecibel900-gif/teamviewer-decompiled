<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/device_authentication_connection_request_padding_start_and_end"
        android:paddingEnd="@dimen/device_authentication_connection_request_padding_start_and_end">
        <TextView
            android:textSize="@dimen/device_authentication_connection_request_text_title"
            android:textStyle="bold"
            android:id="@+id/device_authentication_connection_request_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/device_authentication_connection_request_margin_large"
            android:text="@string/tv_device_authentication_connection_request_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <ImageView
            android:id="@+id/device_authentication_connection_request_device_from_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_device"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/device_authentication_connection_request_from_teamviewer_id_text"
            app:layout_constraintStart_toStartOf="@+id/device_authentication_connection_request_title_text"
            app:layout_constraintTop_toTopOf="@+id/device_authentication_connection_request_from_text"/>
        <TextView
            android:textSize="@dimen/device_authentication_connection_request_text_default"
            android:textStyle="bold"
            android:id="@+id/device_authentication_connection_request_from_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/device_authentication_connection_request_margin_large"
            android:text="@string/tv_device_authentication_connection_request_from"
            android:layout_marginStart="@dimen/device_authentication_connection_request_margin_small"
            app:layout_constraintStart_toEndOf="@+id/device_authentication_connection_request_device_from_image"
            app:layout_constraintTop_toBottomOf="@+id/device_authentication_connection_request_title_text"/>
        <TextView
            android:textSize="@dimen/device_authentication_connection_request_text_default"
            android:ellipsize="end"
            android:id="@+id/device_authentication_connection_request_from_teamviewer_id_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/device_authentication_connection_request_margin_tiny"
            android:textIsSelectable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/device_authentication_connection_request_from_text"
            app:layout_constraintTop_toBottomOf="@+id/device_authentication_connection_request_from_text"/>
        <ImageView
            android:id="@+id/device_authentication_connection_request_device_to_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_device"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/device_authentication_connection_request_to_teamviewer_id_text"
            app:layout_constraintStart_toStartOf="@+id/device_authentication_connection_request_device_from_image"
            app:layout_constraintTop_toTopOf="@+id/device_authentication_connection_request_to_text"/>
        <TextView
            android:textSize="@dimen/device_authentication_connection_request_text_default"
            android:textStyle="bold"
            android:ellipsize="end"
            android:id="@+id/device_authentication_connection_request_to_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/device_authentication_connection_request_margin_medium"
            android:textIsSelectable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/device_authentication_connection_request_from_teamviewer_id_text"
            app:layout_constraintTop_toBottomOf="@+id/device_authentication_connection_request_from_teamviewer_id_text"/>
        <TextView
            android:textSize="@dimen/device_authentication_connection_request_text_default"
            android:ellipsize="end"
            android:id="@+id/device_authentication_connection_request_to_teamviewer_id_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/device_authentication_connection_request_margin_tiny"
            android:textIsSelectable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/device_authentication_connection_request_to_text"
            app:layout_constraintTop_toBottomOf="@+id/device_authentication_connection_request_to_text"/>
        <ImageView
            android:id="@+id/device_authentication_connection_request_time_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_time"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/device_authentication_connection_request_date_text"
            app:layout_constraintStart_toStartOf="@+id/device_authentication_connection_request_device_to_image"
            app:layout_constraintTop_toTopOf="@+id/device_authentication_connection_request_time_text"/>
        <TextView
            android:textSize="@dimen/device_authentication_connection_request_text_default"
            android:textStyle="bold"
            android:ellipsize="end"
            android:id="@+id/device_authentication_connection_request_time_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/device_authentication_connection_request_margin_medium"
            android:textIsSelectable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/device_authentication_connection_request_to_teamviewer_id_text"
            app:layout_constraintTop_toBottomOf="@+id/device_authentication_connection_request_to_teamviewer_id_text"/>
        <TextView
            android:textSize="@dimen/device_authentication_connection_request_text_default"
            android:ellipsize="end"
            android:id="@+id/device_authentication_connection_request_date_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/device_authentication_connection_request_margin_tiny"
            android:textIsSelectable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/device_authentication_connection_request_time_text"
            app:layout_constraintTop_toBottomOf="@+id/device_authentication_connection_request_time_text"/>
        <Button
            android:theme="@style/DeviceAuthenticationConnectionRequestDenyButton"
            android:textSize="@dimen/device_authentication_connection_request_text_button"
            android:id="@+id/device_authentication_connection_request_deny_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/device_authentication_connection_request_button_height"
            android:layout_marginTop="@dimen/device_authentication_connection_request_margin_large"
            android:text="@string/tv_device_authentication_connection_request_deny"
            android:singleLine="true"
            android:layout_marginEnd="@dimen/device_authentication_connection_request_margin_tiny"
            app:layout_constraintEnd_toStartOf="@+id/device_authentication_connection_request_allow_button"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="@+id/device_authentication_connection_request_time_image"
            app:layout_constraintTop_toBottomOf="@+id/device_authentication_connection_request_date_text"/>
        <Button
            android:theme="@style/DeviceAuthenticationConnectionRequestAllowButton"
            android:textSize="@dimen/device_authentication_connection_request_text_button"
            android:id="@+id/device_authentication_connection_request_allow_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/device_authentication_connection_request_button_height"
            android:text="@string/tv_device_authentication_connection_request_allow"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/device_authentication_connection_request_deny_button"
            app:layout_constraintEnd_toEndOf="@+id/device_authentication_connection_request_title_text"
            app:layout_constraintStart_toEndOf="@+id/device_authentication_connection_request_deny_button"
            app:layout_constraintTop_toTopOf="@+id/device_authentication_connection_request_deny_button"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/device_authentication_connection_request_margin_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/device_authentication_connection_request_deny_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
