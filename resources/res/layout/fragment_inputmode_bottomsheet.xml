<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/quick_action_bottom_sheet_layout"
    android:background="@color/tv_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.textview.MaterialTextView
        android:textSize="@dimen/material_text_size_headline_6"
        android:textStyle="bold"
        android:textColor="@color/tv_black"
        android:gravity="fill_vertical"
        android:layout_gravity="fill_vertical"
        android:id="@+id/interaction_mode_header"
        android:paddingTop="@dimen/bottom_sheet_content_top_padding"
        android:paddingBottom="@dimen/bottom_sheet_content_list_item_bottom_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/interaction_mode_header"
        android:drawablePadding="@dimen/bottom_sheet_content_drawable_padding"
        android:paddingStart="@dimen/bottom_sheet_content_left_padding"
        app:drawableLeftCompat="@drawable/interaction_method_mouse"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.chip.ChipGroup
                android:layout_gravity="center_horizontal"
                android:id="@+id/chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/interaction_mode_chip_group_padding_horizontal"
                android:paddingEnd="@dimen/interaction_mode_chip_group_padding_horizontal"
                app:chipSpacingHorizontal="@dimen/interaction_mode_chip_spacing_horizontal"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/mouse_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/interaction_mode_mouse_mode"
                    style="@style/InputModeChipStyle"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/touch_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/interaction_mode_touch_mode"
                    style="@style/InputModeChipStyle"/>
            </com.google.android.material.chip.ChipGroup>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="@color/tv_gray_low_emphasis"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/mode_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="@string/interaction_mode_mouse_description"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="@+id/chip_group"
                app:layout_constraintStart_toStartOf="@+id/chip_group"
                app:layout_constraintTop_toBottomOf="@+id/chip_group"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.7"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/interaction_mode_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="6">
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tip_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interaction_mode_tap_to_click"
                        app:drawableTopCompat="@drawable/tap_to_click"
                        app:layout_constraintEnd_toStartOf="@+id/tip_2"
                        app:layout_constraintHorizontal_chainStyle="spread"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tip_2"
                        style="@style/InputModeTipsStyle"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tip_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interaction_mode_long_tap_to_right_click"
                        app:drawableTopCompat="@drawable/long_tap_to_right_click"
                        app:layout_constraintEnd_toStartOf="@+id/tip_3"
                        app:layout_constraintHorizontal_chainStyle="spread"
                        app:layout_constraintStart_toEndOf="@+id/tip_1"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/InputModeTipsStyle"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tip_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interaction_mode_pinch_to_zoom"
                        app:drawableTopCompat="@drawable/pinch_to_zoom"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_chainStyle="spread"
                        app:layout_constraintStart_toEndOf="@+id/tip_2"
                        app:layout_constraintTop_toTopOf="@+id/tip_2"
                        style="@style/InputModeTipsStyle"/>
                    <Space
                        android:id="@+id/guideline"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        app:layout_constraintTop_toBottomOf="@+id/tip_2"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tip_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interaction_mode_drag_to_move_the_mouse"
                        app:drawableTopCompat="@drawable/drag_to_move_the_mouse"
                        app:layout_constraintEnd_toStartOf="@+id/tip_5"
                        app:layout_constraintHorizontal_chainStyle="spread"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/guideline"
                        style="@style/InputModeTipsStyle"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tip_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interaction_mode_two_fingers_to_scroll"
                        app:drawableTopCompat="@drawable/two_fingers_to_scroll"
                        app:layout_constraintEnd_toStartOf="@+id/tip_6"
                        app:layout_constraintStart_toEndOf="@+id/tip_4"
                        app:layout_constraintTop_toTopOf="@+id/tip_4"
                        style="@style/InputModeTipsStyle"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tip_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interaction_mode_double_tap_and_drag_to_select"
                        app:drawableTopCompat="@drawable/double_tap_and_drag_to_select"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tip_5"
                        app:layout_constraintTop_toTopOf="@+id/tip_5"
                        style="@style/InputModeTipsStyle"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        app:layout_constraintStart_toStartOf="@+id/tip_5"
                        app:layout_constraintTop_toBottomOf="@+id/tip_5"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.7"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
