<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <View
        android:id="@+id/textInputFieldBackground"
        android:background="@drawable/input_text_background"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/sendButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:id="@+id/pilotMarkerTextInput"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="@string/marker_text_input_hint"
        android:inputType="text"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="@+id/textInputFieldBackground"
        app:layout_constraintEnd_toEndOf="@+id/textInputFieldBackground"
        app:layout_constraintStart_toStartOf="@+id/textInputFieldBackground"
        app:layout_constraintTop_toTopOf="@+id/textInputFieldBackground"/>
    <ImageView
        android:id="@+id/sendButton"
        android:layout_width="56dp"
        android:layout_height="36dp"
        android:src="@drawable/send_text_to_marker_icon"
        android:contentDescription="@string/tv_send"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/pilotMarkerTextInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/pilotMarkerTextInput"/>
</androidx.constraintlayout.widget.ConstraintLayout>
