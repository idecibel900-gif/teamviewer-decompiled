<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/managed_groups"
    android:background="?attr/selectableItemBackground"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/redesign_material_section_caption_height"
    app:layout_constraintBottom_toTopOf="@+id/managed_devices"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/plManagedGroupRecyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/managed_devices"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="@dimen/partner_edit_properties_padding_vertical"
        android:paddingBottom="@dimen/partner_edit_properties_padding_vertical"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/plManagedGroupRecyclerView">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/group_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/group_list_group_icon_padding_start"
            app:layout_constraintBottom_toTopOf="@+id/managed_devices"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/managed_devices"
            app:srcCompat="@drawable/ic_folder"/>
        <TextView
            android:textSize="@dimen/buddy_list_item_text_size"
            android:textColor="@color/colorGroupName"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/group_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_managed_device"
            android:maxLines="1"
            android:textIsSelectable="false"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/material_single_line_list_item_padding_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/group_image"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
