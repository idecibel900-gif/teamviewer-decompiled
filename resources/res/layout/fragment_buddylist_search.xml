<?xml version="1.0" encoding="utf-8"?>
<com.teamviewer.remotecontrolviewlib.layout.TVTabOutsideLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center"
        android:id="@+id/no_results_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/buddy_list_no_items_message_padding"
        android:text="@string/search_no_results"
        style="@style/TVTextView"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.teamviewer.remotecontrolviewlib.layout.TVTabOutsideLinearLayout>
