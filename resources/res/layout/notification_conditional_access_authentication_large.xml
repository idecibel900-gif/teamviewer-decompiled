<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textStyle="bold"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conditional_access_authentication_notification_content_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textStyle="italic"
        android:id="@+id/from"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conditional_access_authentication_notification_content_text_sender"/>
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:useDefaultMargins="true">
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conditional_access_authentication_notification_content_text_account"
            android:singleLine="true"
            android:textIsSelectable="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textStyle="bold"
            android:ellipsize="middle"
            android:id="@+id/from_account_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textIsSelectable="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conditional_access_authentication_notification_content_text_device"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textStyle="bold"
            android:ellipsize="middle"
            android:id="@+id/from_device_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textIsSelectable="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conditional_access_authentication_notification_content_text_company"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textStyle="bold"
            android:ellipsize="middle"
            android:id="@+id/from_company_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textIsSelectable="true"/>
    </GridLayout>
    <TextView
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textStyle="italic"
        android:id="@+id/to"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conditional_access_authentication_notification_content_text_receiver"/>
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:useDefaultMargins="true">
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conditional_access_authentication_notification_content_text_account"
            android:singleLine="true"
            android:textIsSelectable="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textStyle="bold"
            android:ellipsize="middle"
            android:id="@+id/to_account_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textIsSelectable="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conditional_access_authentication_notification_content_text_device"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textStyle="bold"
            android:ellipsize="middle"
            android:id="@+id/to_device_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textIsSelectable="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conditional_access_authentication_notification_content_text_company"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textStyle="bold"
            android:ellipsize="middle"
            android:id="@+id/to_company_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textIsSelectable="true"/>
    </GridLayout>
</LinearLayout>
