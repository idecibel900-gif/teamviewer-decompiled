<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="@dimen/bottom_sheet_content_list_item_bottom_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:gravity="start"
        android:id="@+id/list_item_dialog_switch_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/bottom_sheet_content_list_item_left_padding"
        android:paddingEnd="@dimen/bottom_sheet_content_list_item_right_padding"/>
    <TextView
        android:textColor="@android:color/black"
        android:gravity="start|bottom"
        android:id="@+id/list_item_dialog_switch_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/quick_action_switch_button"
        android:paddingStart="@dimen/bottom_sheet_content_list_item_left_padding"
        android:paddingEnd="@dimen/bottom_sheet_content_list_item_right_padding"
        android:layout_toEndOf="@+id/list_item_dialog_switch_icon"/>
    <TextView
        android:textSize="@dimen/material_text_size_caption"
        android:textColor="@android:color/darker_gray"
        android:gravity="left"
        android:id="@+id/list_item_dialog_description"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/quick_action_switch_button"
        android:layout_below="@+id/list_item_dialog_switch_text"
        android:paddingStart="@dimen/bottom_sheet_content_list_item_left_padding"
        android:paddingEnd="@dimen/bottom_sheet_content_list_item_right_padding"
        android:layout_alignStart="@+id/list_item_dialog_switch_text"/>
    <androidx.appcompat.widget.SwitchCompat
        android:theme="@style/TVSwitchStyle"
        android:id="@+id/quick_action_switch_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:checked="false"
        android:layout_alignTop="@+id/list_item_dialog_switch_icon"
        android:paddingStart="@dimen/quick_action_list_switch_start_padding"
        android:paddingEnd="@dimen/quick_action_list_switch_start_padding"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
