<?xml version="1.0" encoding="utf-8"?>
<Keyboard xmlns:app="http://schemas.android.com/apk/res-auto"
    app:keyHeight="@dimen/special_keyboard_key_height"
    app:keyWidth="@dimen/special_keyboard_key_width">
    <Row app:rowEdgeFlags="top">
        <Key
            app:codes="@integer/key_escape"
            app:keyEdgeFlags="left"
            app:keyLabel="Esc"/>
        <Key
            app:codes="@integer/key_fkey_f1"
            app:keyLabel="F1"/>
        <Key
            app:codes="@integer/key_fkey_f2"
            app:keyLabel="F2"/>
        <Key
            app:codes="@integer/key_fkey_f3"
            app:keyLabel="F3"/>
        <Key
            app:codes="@integer/key_fkey_f4"
            app:keyLabel="F4"/>
        <Key
            app:codes="@integer/key_fkey_f5"
            app:keyLabel="F5"/>
        <Key
            app:codes="@integer/key_fkey_f6"
            app:keyEdgeFlags="right"
            app:keyLabel="F6"/>
    </Row>
    <Row app:verticalGap="@dimen/special_keyboard_vertical_gap">
        <Key
            app:codes="@integer/key_tab"
            app:keyEdgeFlags="left"
            app:keyLabel="Tab"/>
        <Key
            app:codes="@integer/key_fkey_f7"
            app:keyLabel="F7"/>
        <Key
            app:codes="@integer/key_fkey_f8"
            app:keyLabel="F8"/>
        <Key
            app:codes="@integer/key_fkey_f9"
            app:keyLabel="F9"/>
        <Key
            app:codes="@integer/key_fkey_f10"
            app:keyLabel="F10"/>
        <Key
            app:codes="@integer/key_fkey_f11"
            app:keyLabel="F11"/>
        <Key
            app:codes="@integer/key_fkey_f12"
            app:keyEdgeFlags="right"
            app:keyLabel="F12"/>
    </Row>
    <Row>
        <Key
            app:codes="@integer/key_prtscrn"
            app:keyEdgeFlags="left"
            app:keyLabel="PrtSc"/>
        <Key
            app:codes="@integer/key_scroll_lock"
            app:keyLabel="ScrLk"/>
        <Key
            app:codes="@integer/key_pause"
            app:keyLabel="Pause"/>
    </Row>
    <Row>
        <Key
            app:codes="@integer/key_insert"
            app:keyEdgeFlags="left"
            app:keyLabel="Ins"/>
        <Key
            app:codes="@integer/key_home"
            app:keyLabel="Home"/>
        <Key
            app:codes="@integer/key_page_up"
            app:keyLabel="PgUp"/>
        <Key
            app:codes="@integer/key_dpad_up"
            app:horizontalGap="@dimen/special_keyboard_key_width_double"
            app:isRepeatable="true"
            app:keyIcon="@drawable/keyboard_arrow_up"/>
    </Row>
    <Row app:rowEdgeFlags="bottom">
        <Key
            app:codes="@integer/key_forward_del"
            app:isRepeatable="true"
            app:keyEdgeFlags="left"
            app:keyLabel="Del"/>
        <Key
            app:codes="@integer/key_end"
            app:keyLabel="End"/>
        <Key
            app:codes="@integer/key_page_down"
            app:keyLabel="PgDn"/>
        <Key
            app:codes="@integer/key_dpad_left"
            app:horizontalGap="@dimen/special_keyboard_key_width"
            app:isRepeatable="true"
            app:keyIcon="@drawable/keyboard_arrow_left"/>
        <Key
            app:codes="@integer/key_dpad_down"
            app:isRepeatable="true"
            app:keyIcon="@drawable/keyboard_arrow_down"/>
        <Key
            app:codes="@integer/key_dpad_right"
            app:isRepeatable="true"
            app:keyEdgeFlags="right"
            app:keyIcon="@drawable/keyboard_arrow_right"/>
    </Row>
</Keyboard>
